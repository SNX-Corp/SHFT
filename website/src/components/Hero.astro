---
import { getEntry } from 'astro:content';
import Button from './Button.astro';

const entry = await getEntry('sections', 'hero');
const d = entry!.data as {
  eyebrow: string;
  headline_line_1: string;
  headline_line_2: string;
  headline_line_3: string;
  subtitle: string;
  cta_primary_label: string;
  cta_primary_href: string;
  cta_secondary_label: string;
  cta_secondary_href: string;
};
---

<section id="hero" class="hero-stage relative min-h-[100svh] flex items-center justify-center overflow-hidden bg-[#0b0b0b]" data-hero>
  <!-- Faint grid, radially masked so it fades toward the edges -->
  <div
    class="absolute inset-0 opacity-[0.05] pointer-events-none"
    style="background-image: linear-gradient(rgba(255,255,255,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.18) 1px, transparent 1px); background-size: 60px 60px; -webkit-mask-image: radial-gradient(120% 100% at 50% 50%, #000, transparent 78%); mask-image: radial-gradient(120% 100% at 50% 50%, #000, transparent 78%);"
  ></div>

  <!-- Cursor-following spotlight (defaults to centre) -->
  <div class="hero-spotlight" data-hero-spotlight aria-hidden="true"></div>

  <!-- Edge vignette to deepen the corners -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(135% 105% at 50% 50%, transparent 52%, rgba(0,0,0,0.6) 100%);"></div>

  <!-- Invisible animation target retained so the existing GSAP sequence stays intact -->
  <div class="sr-only" data-hero-splash></div>

  <!-- Centered content. The big wordmark itself lives in the nav (it morphs up on scroll); this slot reserves its space. -->
  <div class="pointer-events-none relative z-[var(--z-hero-text)] content-width box-border max-w-full text-center" data-hero-copy>
    <div class="flex flex-col items-center">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6 sm:mb-8" data-hero-eyebrow>
        <span class="block w-1.5 h-1.5 rounded-full bg-accent pulse-dot"></span>
        <span class="font-heading font-semibold text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-white/65">
          {d.eyebrow}
        </span>
      </div>

      <!-- Logo slot: the morphing wordmark sits centered here at rest -->
      <div class="hero-logo-slot" data-hero-logo-slot aria-hidden="true"></div>

      <!-- Tagline -->
      <p class="font-heading font-medium text-[0.98rem] sm:text-[clamp(1rem,1.3vw,1.15rem)] text-white/70 max-w-xl mt-8 sm:mt-10 leading-relaxed" data-hero-sub>
        {d.subtitle}
      </p>

      <!-- CTA -->
      <div class="pointer-events-auto mt-8 sm:mt-10" data-hero-cta>
        <Button href={d.cta_primary_href} variant="primary" size="large" data-open-join-modal>{d.cta_primary_label}</Button>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2" data-hero-scroll>
    <span class="font-heading text-[10px] uppercase tracking-[0.2em] text-white/35">Scroll</span>
    <div class="w-px h-12 bg-white/20 relative overflow-hidden">
      <div class="w-full h-4 bg-accent animate-[scrollDown_2s_ease-in-out_infinite]"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }
  .hero-logo-slot {
    height: var(--hero-logo-h, clamp(3.25rem, 12vh, 8.5rem));
    width: 1px;
  }
  .hero-spotlight {
    position: absolute;
    top: 0;
    left: 0;
    width: 64rem;
    height: 64rem;
    margin: -32rem 0 0 -32rem;
    pointer-events: none;
    background: radial-gradient(circle,
      rgba(166, 255, 0, 0.16) 0%,
      rgba(166, 255, 0, 0.06) 26%,
      rgba(255, 255, 255, 0.035) 44%,
      transparent 66%);
    will-change: transform;
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const spot = document.querySelector<HTMLElement>('[data-hero-spotlight]');

  if (hero && spot) {
    const center = () => {
      const r = hero.getBoundingClientRect();
      return { x: r.width / 2, y: r.height / 2 };
    };
    let { x: tx, y: ty } = center();
    let cx = tx;
    let cy = ty;
    let raf = 0;

    const apply = () => spot.style.transform = `translate(${cx}px, ${cy}px)`;

    const tick = () => {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      apply();
      if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      kick();
    });
    hero.addEventListener('pointerleave', () => {
      const c = center();
      tx = c.x;
      ty = c.y;
      kick();
    });
    window.addEventListener('resize', () => {
      const c = center();
      tx = cx = c.x;
      ty = cy = c.y;
      apply();
    });

    apply();
  }
</script>
