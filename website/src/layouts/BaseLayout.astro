---
import '../styles/global.css';
import '../fonts/index.ts';
import Preloader from '../components/Preloader.astro';
import JoinModal from '../components/JoinModal.astro';

interface Props {
  title?: string;
  description?: string;
  showJoinModal?: boolean;
  preloader?: boolean;
}

const {
  title = 'Team SHFT - FRC Robotics',
  description = 'SHIFT our mindset. ELEVATE our impact. Team SHFT is a competitive FIRST Robotics team building the future of engineering.',
  showJoinModal = true,
  preloader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>
  </head>
  <body class="bg-bg text-text-primary">
    {preloader && <Preloader />}
    <slot />

    {showJoinModal && <JoinModal />}

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
