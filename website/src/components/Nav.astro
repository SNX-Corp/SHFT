---
import { getEntry } from 'astro:content';

const entry = await getEntry('sections', 'nav');
const d = entry!.data as {
  cta_label: string;
  cta_href: string;
  links: Array<{ label: string; href: string }>;
};
const navLinks = d.links;
---

<header
  id="nav"
  class="fixed top-0 left-0 right-0 z-[var(--z-nav)] bg-transparent transition-colors duration-[var(--duration-normal)]"
  data-nav
>
  <!-- Dark scrim - keeps nav text readable over the hero -->
  <div
    class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/70 to-transparent pointer-events-none transition-opacity duration-300"
    data-nav-scrim
  ></div>

  <div class="relative content-width box-border max-w-full flex items-center justify-between h-16 lg:h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center group" aria-label="Team SHFT - home">
      <img
        src="/images/logo/wordmark.png"
        alt="Team SHFT"
        class="h-[22px] lg:h-7 w-auto"
        data-nav-logo
      />
    </a>

    <!-- Desktop links -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-heading font-semibold text-[13px] uppercase tracking-[0.1em] text-white hover:text-accent transition-colors duration-200"
          data-nav-link
        >
          {link.label}
        </a>
      ))}
      <a
        href={d.cta_href}
        class="bg-white text-surface-alt font-heading font-bold text-[13px] uppercase tracking-wide px-5 py-2.5 hover:opacity-90 transition-all duration-200 active:scale-[0.97]"
        data-nav-cta
        data-open-join-modal
      >
        {d.cta_label}
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="lg:hidden fixed top-3 right-4 z-[60] flex flex-col justify-center items-center w-11 h-11 gap-[6px] rounded-full border border-accent bg-accent shadow-[0_8px_24px_rgba(0,0,0,.28)] backdrop-blur-sm transition-colors duration-200 group"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-mobile-toggle
    >
      <span class="block w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" data-bar-1></span>
      <span class="block w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" data-bar-2></span>
    </button>
  </div>
</header>

<!-- Mobile overlay -->
<div
  class="fixed inset-0 z-[var(--z-overlay)] bg-bg pointer-events-none opacity-0 transition-opacity duration-300 lg:hidden"
  data-mobile-menu
>
  <div class="flex flex-col items-center justify-center h-full gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-heading font-bold text-[clamp(1.5rem,7vw,2rem)] uppercase tracking-tight text-text-primary hover:text-accent transition-colors duration-200"
        data-mobile-link
      >
        {link.label}
      </a>
    ))}
    <a
      href={d.cta_href}
      class="mt-4 bg-accent text-accent-text font-heading font-bold text-[14px] uppercase tracking-wide px-8 py-4 hover:bg-accent-hover transition-colors duration-200"
      data-mobile-link
      data-open-join-modal
    >
      {d.cta_label}
    </a>
  </div>
</div>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const navScrim = document.querySelector('[data-nav-scrim]') as HTMLElement;
  const logo = document.querySelector('[data-nav-logo]') as HTMLImageElement;
  const navLinks = document.querySelectorAll('[data-nav-link]');
  const navCta = document.querySelector('[data-nav-cta]') as HTMLElement;
  const mobileToggle = document.querySelector('[data-mobile-toggle]') as HTMLElement;
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement;
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const bar1 = document.querySelector('[data-bar-1]') as HTMLElement;
  const bar2 = document.querySelector('[data-bar-2]') as HTMLElement;

  let menuOpen = false;

  function setBars(dark: boolean) {
    [bar1, bar2].forEach((b) => {
      b.classList.toggle('bg-text-primary', true);
      b.classList.toggle('bg-white', false);
    });

    mobileToggle.classList.toggle('border-black/10', dark);
    mobileToggle.classList.toggle('bg-white/85', dark);
    mobileToggle.classList.toggle('border-accent', !dark);
    mobileToggle.classList.toggle('bg-accent', !dark);
  }

  function updateNav() {
    const pastHero = window.scrollY > window.innerHeight * 0.8;

    if (pastHero) {
      nav.classList.add('bg-bg', 'shadow-[0_1px_0_var(--color-border)]');
      nav.classList.remove('bg-transparent');
      navScrim.classList.add('opacity-0');
      logo.src = '/images/logo/wordmark-dark.png';
      navLinks.forEach((l) => {
        l.classList.remove('text-white', 'hover:text-accent');
        l.classList.add('text-text-secondary', 'hover:text-text-primary');
      });
      navCta.classList.remove('bg-white', 'text-surface-alt');
      navCta.classList.add('bg-accent', 'text-accent-text');
    } else {
      nav.classList.remove('bg-bg', 'shadow-[0_1px_0_var(--color-border)]');
      nav.classList.add('bg-transparent');
      navScrim.classList.remove('opacity-0');
      logo.src = '/images/logo/wordmark.png';
      navLinks.forEach((l) => {
        l.classList.add('text-white', 'hover:text-accent');
        l.classList.remove('text-text-secondary', 'hover:text-text-primary');
      });
      navCta.classList.add('bg-white', 'text-surface-alt');
      navCta.classList.remove('bg-accent', 'text-accent-text');
    }

    if (!menuOpen) setBars(pastHero);
  }

  function toggleMobile() {
    menuOpen = !menuOpen;
    mobileToggle.setAttribute('aria-expanded', String(menuOpen));

    if (menuOpen) {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
      bar1.style.transform = 'rotate(45deg) translateY(4px)';
      bar2.style.transform = 'rotate(-45deg) translateY(-4px)';
      setBars(true);
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
      bar1.style.transform = '';
      bar2.style.transform = '';
      document.body.style.overflow = '';
      updateNav();
    }
  }

  mobileToggle?.addEventListener('click', toggleMobile);
  mobileLinks.forEach(link => link.addEventListener('click', () => {
    if (menuOpen) toggleMobile();
  }));

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();
</script>
