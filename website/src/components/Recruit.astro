---
import Button from './Button.astro';
---

<section id="recruit" class="relative py-32 lg:py-48 bg-surface-alt text-text-inverse overflow-hidden">
  <!-- Diagonal grid texture -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(45deg, rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(-45deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <!-- Green glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/5 rounded-full blur-[120px]"></div>

  <div class="relative z-10 content-width text-center">
    <div data-recruit-eyebrow class="flex items-center justify-center gap-3 mb-8">
      <div class="w-6 h-px bg-accent"></div>
      <span class="font-heading font-semibold text-[11px] uppercase tracking-[0.2em] text-white/30">
        Now Recruiting
      </span>
      <div class="w-6 h-px bg-accent"></div>
    </div>

    <h2 data-recruit-heading class="font-display font-black text-display-size text-white mb-6">
      JOIN THE<br /><span class="text-accent">SHIFT.</span>
    </h2>

    <p data-recruit-sub class="font-heading font-medium text-[clamp(1rem,2vw,1.25rem)] text-white/40 max-w-xl mx-auto mb-12 leading-relaxed">
      We're looking for builders, thinkers, coders, designers, and anyone who refuses to settle for average.
    </p>

    <div data-recruit-cta class="flex flex-wrap justify-center gap-4">
      <Button href="mailto:team@teamshiftfrc.com" variant="primary" size="large">
        Apply now
      </Button>
      <a
        href="#about"
        class="inline-flex items-center justify-center font-heading font-bold uppercase tracking-wide text-[14px] px-8 py-4 border border-white/20 text-white hover:border-white/50 transition-all duration-200 active:scale-[0.97]"
      >
        Learn more
      </a>
    </div>
  </div>
</section>
