---
---

<section class="relative bg-surface-alt text-text-inverse pt-32 pb-24 lg:pt-44 lg:pb-40 overflow-hidden">
  <!-- Workshop background photo -->
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/parents/shiftlab1.png');"></div>

  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-surface-alt/80"></div>

  <!-- Subtle grid texture -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <!-- Accent glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/5 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="relative content-width">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-8 h-px bg-accent"></div>
      <span class="text-label-size font-heading text-accent">ONTARIO COMMUNITY FRC TEAM</span>
    </div>

    <h1 class="font-display font-black text-[clamp(3.2rem,6vw,5.5rem)] leading-[0.9] tracking-[-0.04em] text-white mb-8 max-w-4xl">
      <span class="block text-accent">SHIFT</span>
      <span class="block">THE</span>
      <span class="block">STANDARD.</span>
    </h1>

    <p class="font-heading font-medium text-[clamp(0.95rem,1.25vw,1.08rem)] text-white/60 max-w-2xl mb-10 lg:mb-12 leading-relaxed">
      A new Ontario-based community team built around competitive engineering,<br class="hidden sm:block" />
      real impact, and teaching the next generation of problem-solvers.
    </p>

    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="#pricing"
        class="inline-flex items-center justify-center bg-accent text-accent-text font-heading font-bold text-[13px] uppercase tracking-wide px-8 py-4 hover:bg-accent-hover transition-all duration-200 active:scale-[0.97]"
      >
        View Pricing
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center border border-white/20 text-white font-heading font-bold text-[13px] uppercase tracking-wide px-8 py-4 hover:border-white/40 hover:bg-white/5 transition-all duration-200 active:scale-[0.97]"
      >
        Book a Meeting
      </a>
    </div>
  </div>
</section>
