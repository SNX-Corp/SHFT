---
import { getEntry } from 'astro:content';

const entry = await getEntry('sections', 'marquee');
const items = (entry!.data as { items: string[] }).items;

const marqueeContent = items.join('     •     ') + '     •     ';
---

<div class="relative z-[var(--z-marquee)] bg-accent overflow-hidden py-4 lg:py-5 select-none">
  <div class="marquee-track flex whitespace-nowrap w-max">
    <span class="font-heading font-bold text-[13px] lg:text-[15px] uppercase tracking-[0.18em] text-accent-text">
      {marqueeContent}
    </span>
    <span class="font-heading font-bold text-[13px] lg:text-[15px] uppercase tracking-[0.18em] text-accent-text" aria-hidden="true">
      {marqueeContent}
    </span>
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track {
    animation: marquee 44s linear infinite;
    will-change: transform;
  }
</style>
