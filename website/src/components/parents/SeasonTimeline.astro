---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'timeline');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  intro: string;
  phases: Array<{
    period: string;
    title: string;
    description: string;
    intensity: 'low' | 'medium' | 'high';
  }>;
};

const intensityColors: Record<string, string> = {
  low: "bg-white/20",
  medium: "bg-accent/50",
  high: "bg-accent",
};

const intensityLabels: Record<string, string> = {
  low: "Ramp-up",
  medium: "Building",
  high: "Full intensity",
};
---

<section class="py-20 lg:py-40 bg-surface">
  <div class="content-width">
    <SectionLabel number={d.section_number} text={d.section_label} />

    <h2 class="font-display font-black text-h2-size mb-6">
      <span class="title-shine is-dark delay-5">{d.headline_line_1}</span><br/>
      <span class="title-shine is-dark delay-6">{d.headline_line_2}</span>
    </h2>

    <p class="font-body text-[16px] text-text-secondary leading-relaxed max-w-2xl mb-16">
      {d.intro}
    </p>

    <!-- Timeline -->
    <div class="relative pl-8 lg:pl-12">
      <div class="absolute left-0 top-0 bottom-0 w-px bg-border"></div>

      <div class="space-y-10 lg:space-y-14">
        {d.phases.map((phase) => (
          <div class="relative">
            <!-- Dot -->
            <div
              class="absolute -left-8 lg:-left-12 top-2 w-4 h-4 border-2 border-accent bg-bg rounded-full flex items-center justify-center"
              data-timeline-phase={phase.period}
            >
              <div class:list={["w-1.5 h-1.5 rounded-full", intensityColors[phase.intensity]]}></div>
            </div>

            <!-- Period badge -->
            <div class="flex items-center gap-3 mb-2">
              <span class="font-display font-black text-[14px] text-text-primary tracking-wide">{phase.period}</span>
              <span class:list={[
                "text-[10px] font-heading font-bold uppercase tracking-[0.15em] px-2.5 py-1",
                phase.intensity === "high" ? "bg-accent text-accent-text" :
                phase.intensity === "medium" ? "bg-accent/20 text-accent" :
                "bg-border text-text-muted",
              ]}>
                {intensityLabels[phase.intensity]}
              </span>
            </div>

            <h3 class="font-heading font-bold text-[1.25rem] text-text-primary mb-2">{phase.title}</h3>
            <p class="font-body text-text-secondary text-[15px] leading-relaxed max-w-xl">{phase.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // E — Highlight the timeline dot whose period covers today's month.
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  function periodCovers(period: string, currentIdx: number): boolean {
    const text = period.toUpperCase().trim();
    const range = text.match(/^([A-Z]{3,})\s*[-–]\s*([A-Z]{3,})$/);
    if (range) {
      const startIdx = months.indexOf(range[1].slice(0, 3));
      const endIdx = months.indexOf(range[2].slice(0, 3));
      if (startIdx < 0 || endIdx < 0) return false;
      if (startIdx <= endIdx) {
        return currentIdx >= startIdx && currentIdx <= endIdx;
      }
      return currentIdx >= startIdx || currentIdx <= endIdx;
    }
    const single = months.findIndex((m) => text.startsWith(m));
    return single === currentIdx;
  }
  const currentMonth = new Date().getMonth();
  const dots = document.querySelectorAll<HTMLElement>('[data-timeline-phase]');
  // Single-month phases beat ranges (so JANUARY wins over JAN – FEB for early Jan).
  const single: HTMLElement[] = [];
  const ranges: HTMLElement[] = [];
  dots.forEach((el) => {
    const period = (el.dataset.timelinePhase || '').toUpperCase();
    (period.includes('-') || period.includes('–') ? ranges : single).push(el);
  });
  const ordered = [...single, ...ranges];
  for (const el of ordered) {
    if (periodCovers(el.dataset.timelinePhase || '', currentMonth)) {
      el.classList.add('timeline-now');
      break;
    }
  }
</script>
