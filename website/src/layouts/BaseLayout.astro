---
import '../styles/global.css';
import '../fonts/index.ts';
import Preloader from '../components/Preloader.astro';
import JoinModal from '../components/JoinModal.astro';

interface Props {
  title?: string;
  description?: string;
  showJoinModal?: boolean;
  preloader?: boolean;
  noindex?: boolean;
}

const {
  title = 'Team SHFT - FRC Robotics',
  description = 'Shift the standard. Team SHFT is a competitive FIRST Robotics team based in Ontario.',
  showJoinModal = true,
  preloader = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og/og-default.png', Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Team SHFT',
  alternateName: 'SHFT Robotics',
  url: Astro.site?.toString(),
  logo: new URL('/brand/png/shft-robotics-lockup-full-on-light.png', Astro.site).toString(),
  sport: 'Robotics',
  areaServed: {
    '@type': 'State',
    name: 'Ontario',
  },
  sameAs: ['https://www.instagram.com/shftrobotics/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script
      defer
      src="https://stats.shftrobotics.com/script.js"
      data-website-id="8d4b1452-9741-4a8e-b6a8-9e5e2301a60a"></script>
  </head>
  <body class="bg-bg text-text-primary">
    {preloader && <Preloader />}
    <slot />

    {showJoinModal && <JoinModal />}

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
