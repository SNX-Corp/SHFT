---
// Per-character rolling hover (landonorris.com style): each letter is a
// clipped box holding two stacked copies. On hover of the parent, every
// letter rolls up with a staggered delay, creating a wave. Spaces render as
// real spaces so long strings still wrap at word boundaries.
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
const chars = [...text];
---
<span class:list={['text-roll', className]} aria-label={text}>
  {chars.map((ch, i) =>
    ch === ' ' ? (
      ' '
    ) : (
      <span class="text-roll__char" style={`--ri:${i}`} aria-hidden="true">
        <span class="text-roll__col">
          <span>{ch}</span>
          <span>{ch}</span>
        </span>
      </span>
    )
  )}
</span>
