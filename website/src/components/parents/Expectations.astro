---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'expectations');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  students_label: string;
  parents_label: string;
  students: Array<{ title: string; description: string }>;
  parents: Array<{ title: string; description: string }>;
};
---

<section class="py-20 lg:py-40 bg-bg">
  <div class="content-width">
    <SectionLabel number={d.section_number} text={d.section_label} />

    <h2 class="font-display font-black text-h2-size mb-12 lg:mb-24">
      <span class="title-shine is-dark delay-6">{d.headline_line_1}</span><br/>
      <span class="title-shine is-dark delay-7">{d.headline_line_2}</span>
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <!-- Students -->
      <div>
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-accent text-accent-text font-display font-black text-[14px] flex items-center justify-center">S</div>
          <div class="text-label-size font-heading text-text-muted">{d.students_label}</div>
        </div>

        <div class="space-y-6">
          {d.students.map((item) => (
            <div class="border-l-2 border-border pl-6 py-1 hover:border-accent transition-colors duration-200">
              <div class="font-heading font-bold text-[15px] text-text-primary mb-1">{item.title}</div>
              <p class="font-body text-[14px] text-text-secondary leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Parents -->
      <div>
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-surface-alt text-white font-display font-black text-[14px] flex items-center justify-center">P</div>
          <div class="text-label-size font-heading text-text-muted">{d.parents_label}</div>
        </div>

        <div class="space-y-6">
          {d.parents.map((item) => (
            <div class="border-l-2 border-border pl-6 py-1 hover:border-accent transition-colors duration-200">
              <div class="font-heading font-bold text-[15px] text-text-primary mb-1">{item.title}</div>
              <p class="font-body text-[14px] text-text-secondary leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
