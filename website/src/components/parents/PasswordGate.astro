---
---

<div id="password-gate" class="fixed inset-0 z-[60] bg-surface-alt flex items-center justify-center">
  <div class="text-center px-6 max-w-md w-full">
    <img
      src="/images/logo/wordmark.png"
      alt="Team SHIFT"
      class="h-8 lg:h-10 w-auto mx-auto mb-12"
    />

    <p class="font-heading font-semibold text-[13px] uppercase tracking-[0.15em] text-white/40 mb-8">
      This page is invite-only
    </p>

    <div class="relative">
      <input
        id="gate-input"
        type="password"
        placeholder="Enter access code"
        autocomplete="off"
        class="w-full bg-transparent border border-white/20 text-white font-heading text-[15px] tracking-wide px-5 py-4 focus:outline-none focus:border-accent transition-colors duration-200 placeholder:text-white/20"
      />
      <button
        id="gate-submit"
        class="absolute right-2 top-1/2 -translate-y-1/2 bg-accent text-accent-text font-heading font-bold text-[12px] uppercase tracking-wide px-4 py-2 hover:bg-accent-hover transition-colors duration-200 active:scale-[0.97]"
      >
        Enter
      </button>
    </div>

    <p id="gate-error" class="font-body text-[13px] text-red-400 mt-4 opacity-0 transition-opacity duration-200">
      Incorrect code. Please try again.
    </p>
  </div>
</div>

<script>
  const PASS_HASH = "shft2026";
  const STORAGE_KEY = "shft-parents-auth";

  const gate = document.getElementById("password-gate") as HTMLElement;
  const input = document.getElementById("gate-input") as HTMLInputElement;
  const submit = document.getElementById("gate-submit") as HTMLButtonElement;
  const error = document.getElementById("gate-error") as HTMLElement;

  if (sessionStorage.getItem(STORAGE_KEY) === "granted") {
    gate.remove();
  } else {
    document.body.style.overflow = "hidden";
  }

  function attempt() {
    if (input.value === PASS_HASH) {
      sessionStorage.setItem(STORAGE_KEY, "granted");
      gate.style.opacity = "0";
      gate.style.transition = "opacity 0.4s ease";
      document.body.style.overflow = "";
      setTimeout(() => gate.remove(), 400);
    } else {
      error.style.opacity = "1";
      input.classList.add("border-red-400");
      setTimeout(() => {
        error.style.opacity = "0";
        input.classList.remove("border-red-400");
      }, 2000);
    }
  }

  submit?.addEventListener("click", attempt);
  input?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") attempt();
  });
</script>
