---
import SectionLabel from '../SectionLabel.astro';
---

<section class="py-24 lg:py-40 bg-bg">
  <div class="content-width">
    <SectionLabel number="01" text="THE VISION" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <div>
        <h2 class="font-display font-black text-h2-size text-text-primary mb-8">
          NOT JUST A TEAM.<br/>
          <span class="text-accent-dim">A LAUNCHPAD.</span>
        </h2>

        <div class="space-y-6">
          <p class="font-body text-[16px] text-text-secondary leading-[1.8]">
            SHFT isn't another robotics club. It's a professional-grade program built by mentors
            who have proven they can take a team from nothing to the top of Canadian FRC — and
            who are doing it again, the right way.
          </p>
          <p class="font-body text-[16px] text-text-secondary leading-[1.8]">
            We meet with every family individually. We understand your child's goals. And we
            build a path to get them there — whether that's engineering school, leadership
            experience, or simply becoming someone who knows how to build things that matter.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="border border-border p-6 lg:p-8">
          <div class="font-display font-black text-[2.5rem] text-text-primary leading-none mb-2">10</div>
          <div class="text-label-size font-heading text-text-muted">Founding Students</div>
          <p class="font-body text-[13px] text-text-secondary mt-2">Hand-selected first cohort</p>
        </div>
        <div class="border border-border p-6 lg:p-8">
          <div class="font-display font-black text-[2.5rem] text-accent-dim leading-none mb-2">1:5</div>
          <div class="text-label-size font-heading text-text-muted">Mentor Ratio</div>
          <p class="font-body text-[13px] text-text-secondary mt-2">Unmatched personal attention</p>
        </div>
        <div class="border border-border p-6 lg:p-8">
          <div class="font-display font-black text-[2.5rem] text-text-primary leading-none mb-2">20</div>
          <div class="text-label-size font-heading text-text-muted">Max Roster</div>
          <p class="font-body text-[13px] text-text-secondary mt-2">Quality over quantity</p>
        </div>
        <div class="border border-border p-6 lg:p-8 border-t-2 border-t-accent">
          <div class="font-display font-black text-[2.5rem] text-text-primary leading-none mb-2">∞</div>
          <div class="text-label-size font-heading text-text-muted">Ambition</div>
          <p class="font-body text-[13px] text-text-secondary mt-2">Top 5 in Ontario. Year one.</p>
        </div>
      </div>
    </div>
  </div>
</section>
