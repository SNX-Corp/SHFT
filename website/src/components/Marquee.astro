---
import { getEntry } from 'astro:content';

const entry = await getEntry('sections', 'marquee');
const items = (entry!.data as { items: string[] }).items;
// Two identical copies so the -50% translate loops seamlessly.
const loop = [...items, ...items];
---

<div class="relative z-[var(--z-marquee)] bg-accent overflow-hidden py-2 lg:py-2.5 select-none">
  <div class="marquee-track flex items-center gap-10 lg:gap-16 w-max">
    {loop.map((item, i) => (
      <Fragment>
        <span class="font-heading font-bold text-[10.5px] lg:text-[11.5px] uppercase tracking-[0.2em] text-accent-text whitespace-nowrap" aria-hidden={i >= items.length ? 'true' : undefined}>
          {item}
        </span>
        <span class="text-accent-text/45 text-[8px] leading-none" aria-hidden="true">●</span>
      </Fragment>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track {
    animation: marquee 44s linear infinite;
    will-change: transform;
  }
</style>
