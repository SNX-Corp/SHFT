---
import { social } from '../data/social';

const links = [
  { label: 'Vision', href: '#vision' },
  { label: 'Mentor', href: '#mentor' },
  { label: 'Program', href: '#program' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Contact', href: '#contact' },
];
---

<footer class="bg-surface-alt text-text-inverse">
  <div class="content-width py-14 lg:py-20">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-12 mb-14">
      <div>
        <img
          src="/images/logo/wordmark.png"
          alt="Team SHFT"
          class="h-10 lg:h-14 w-auto"
        />
        <p class="font-body text-[14px] text-white/40 mt-3 max-w-sm">
          SHFT our mindset. ELEVATE our impact.
        </p>
      </div>

      <div class="flex flex-col sm:items-end gap-6">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {links.map((link) => (
            <a
              href={link.href}
              class="font-heading text-[12px] font-bold uppercase tracking-[0.12em] text-white/60 hover:text-accent transition-colors duration-200 py-[13px] -my-[13px]"
            >
              {link.label}
            </a>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {social.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-white/35 hover:text-accent transition-colors duration-200 py-[13px] -my-[13px]"
            >
              {s.platform}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-8 border-t border-white/10">
      <p class="font-body text-[12px] text-white/30">
        &copy; {new Date().getFullYear()} Team SHFT. All rights reserved.
      </p>
      <a
        href="#hero"
        class="font-heading text-[11px] font-semibold uppercase tracking-[0.15em] text-white/40 hover:text-accent transition-colors duration-200 py-[14px] -my-[14px]"
      >
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
