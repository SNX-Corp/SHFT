---
const items = [
  'TEAM SHFT',
  'FRC',
  'FOCUS',
  'ELEVATE',
  'INNOVATE',
  'TOGETHER',
  'EST. 2025',
  'REAL ENGINEERING',
  'SHIFT YOUR MINDSET',
];

const marqueeContent = items.join(' ◆ ') + ' ◆ ';
---

<div class="relative z-[var(--z-marquee)] bg-accent overflow-hidden py-4 select-none">
  <div class="flex whitespace-nowrap animate-[marquee_12s_linear_infinite]">
    <span class="font-heading font-bold text-[14px] lg:text-[16px] uppercase tracking-[0.15em] text-accent-text px-4">
      {marqueeContent}
    </span>
    <span class="font-heading font-bold text-[14px] lg:text-[16px] uppercase tracking-[0.15em] text-accent-text px-4" aria-hidden="true">
      {marqueeContent}
    </span>
    <span class="font-heading font-bold text-[14px] lg:text-[16px] uppercase tracking-[0.15em] text-accent-text px-4" aria-hidden="true">
      {marqueeContent}
    </span>
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[marquee_12s_linear_infinite\] {
      animation: none;
    }
  }
</style>
