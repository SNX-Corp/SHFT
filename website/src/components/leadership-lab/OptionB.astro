---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'mentors');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  mentors: Array<{
    name: string;
    role_tagline: string;
    bio_1: string;
    bio_2: string;
    quote: string;
    credentials: Array<{ label: string; value: string }>;
  }>;
};

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---

<section id="lead-b" class="option-b py-20 lg:py-36 bg-[var(--color-bg)]">
  <div class="content-width">

    <!-- Section label -->
    <SectionLabel number={d.section_number} text={d.section_label} />

    <!-- Masthead headline -->
    <div class="masthead mb-20 lg:mb-32">
      <h2 class="font-display font-black text-h2-size leading-[0.92] tracking-[-0.04em] uppercase">
        <span class="title-shine is-dark delay-1">{d.headline_line_1}</span>
        <br />
        <span class="title-shine is-dark delay-2">{d.headline_line_2}</span>
      </h2>
      <div class="masthead-rule" aria-hidden="true"></div>
    </div>

    <!-- Mentor features -->
    {d.mentors.map((mentor, i) => {
      const isEven = i % 2 === 0;
      const initials = getInitials(mentor.name);

      return (
        <article class:list={['mentor-feature', i > 0 && 'mentor-feature--divider']}>

          <!-- Oversized name -->
          <div class="name-anchor" aria-hidden="true">
            <span class="font-display font-black uppercase name-text">
              {mentor.name}
            </span>
          </div>

          <!-- Content grid: portrait + body -->
          <div class:list={[
            'feature-grid',
            isEven ? 'feature-grid--portrait-left' : 'feature-grid--portrait-right',
          ]}>

            <!-- Portrait placeholder -->
            <div class="portrait-wrap">
              <div class="portrait">
                <div class="portrait-bg">
                  <div class="portrait-inner">
                    <!-- Initials -->
                    <div class="initials-block">
                      <span class="initials font-display">{initials}</span>
                    </div>
                    <!-- Name + role pinned to bottom -->
                    <div class="portrait-caption">
                      <div class="font-display font-black portrait-name">{mentor.name.toUpperCase()}</div>
                      <div class="portrait-role text-label-size font-heading">{mentor.role_tagline.toUpperCase()}</div>
                    </div>
                  </div>
                  <!-- Lime accent bar -->
                  <div class="portrait-bar" aria-hidden="true"></div>
                </div>
              </div>
            </div>

            <!-- Editorial body -->
            <div class="feature-body">

              <!-- Role eyebrow -->
              <div class="role-eyebrow text-label-size font-heading">{mentor.role_tagline.toUpperCase()}</div>

              <!-- Two-column bio -->
              <div class="bio-columns">
                <p class="bio-text">{mentor.bio_1}</p>
                <p class="bio-text">{mentor.bio_2}</p>
              </div>

              <!-- Pull-quote -->
              <blockquote class="pull-quote">
                <p class="pull-quote-text font-heading">{mentor.quote}</p>
              </blockquote>

              <!-- Credentials grid -->
              <div class="credentials">
                {mentor.credentials.map((item) => (
                  <div class="cred">
                    <div class="cred-label text-label-size font-heading">{item.label}</div>
                    <div class="cred-value font-heading">{item.value}</div>
                  </div>
                ))}
              </div>

            </div>
          </div>

        </article>
      );
    })}

  </div>
</section>

<style>
  /* ── Masthead rule ── */
  .masthead-rule {
    margin-top: 1.5rem;
    height: 1px;
    width: 100%;
    background: var(--color-border);
  }

  /* ── Name anchor: oversized Orbitron behind the card ── */
  .name-anchor {
    overflow: hidden;
    margin-bottom: -0.15em; /* pull content up under the name for overlap feel */
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .name-text {
    display: block;
    font-size: clamp(2.75rem, 7vw, 6rem);
    letter-spacing: -0.03em;
    line-height: 0.92;
    color: var(--color-text-primary);
    padding-bottom: 0.12em;
  }

  /* ── Feature article ── */
  .mentor-feature {
    padding-bottom: 6rem;
  }

  .mentor-feature--divider {
    padding-top: 5rem;
    border-top: 1px solid var(--color-border);
  }

  /* ── Content grid ── */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .feature-grid {
      grid-template-columns: 360px 1fr;
      gap: 5rem;
      align-items: start;
    }

    .feature-grid--portrait-right {
      grid-template-columns: 1fr 360px;
    }

    .feature-grid--portrait-right .portrait-wrap {
      order: 2;
    }

    .feature-grid--portrait-right .feature-body {
      order: 1;
    }
  }

  /* ── Portrait ── */
  .portrait-wrap {
    flex-shrink: 0;
  }

  .portrait {
    width: 100%;
    max-width: 360px;
  }

  @media (max-width: 1023px) {
    .portrait {
      max-width: 100%;
    }
  }

  .portrait-bg {
    position: relative;
    background: var(--color-surface-alt);
    aspect-ratio: 3 / 4.6;
    overflow: hidden;
  }

  .portrait-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem 1.75rem 2.5rem;
  }

  .initials-block {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .initials {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: rgba(166, 255, 0, 0.18);
    line-height: 1;
    user-select: none;
  }

  .portrait-caption {
    position: relative;
    z-index: 2;
  }

  .portrait-name {
    font-size: 0.95rem;
    color: var(--color-text-inverse);
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }

  .portrait-role {
    color: var(--color-accent);
    letter-spacing: 0.14em;
    font-size: var(--text-label);
  }

  .portrait-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
  }

  /* ── Feature body ── */
  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Role eyebrow */
  .role-eyebrow {
    color: var(--color-accent-dim);
    letter-spacing: 0.16em;
    font-size: var(--text-label);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    display: inline-block;
  }

  /* Bio two-column on desktop */
  .bio-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .bio-columns {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .bio-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.78;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Pull-quote — clean accent rule */
  .pull-quote {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-accent);
  }

  .pull-quote-text {
    font-size: clamp(1.1rem, 1.9vw, 1.4rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }

  /* Credentials — tidy two-column key/value grid with row dividers */
  .credentials {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .credentials {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cred {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cred-label {
    color: var(--color-text-muted);
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .cred-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.45;
  }
</style>
