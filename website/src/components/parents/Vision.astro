---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'vision');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  paragraph_1: string;
  paragraph_2: string;
  stats: Array<{
    value: string;
    label: string;
    description: string;
    accent?: boolean;
    accent_border?: boolean;
  }>;
};
---

<section id="vision" class="py-20 lg:py-40 bg-bg">
  <div class="content-width">
    <SectionLabel number={d.section_number} text={d.section_label} />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <div>
        <h2 class="font-display font-black text-h2-size text-text-primary mb-8">
          {d.headline_line_1}<br/>
          <span class="text-accent">{d.headline_line_2}</span>
        </h2>

        <div class="space-y-6">
          <p class="font-body text-[16px] text-text-secondary leading-[1.8]">
            {d.paragraph_1}
          </p>
          <p class="font-body text-[16px] text-text-secondary leading-[1.8]">
            {d.paragraph_2}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {d.stats.map((stat) => (
          <div class:list={[
            "border border-border p-6 lg:p-8",
            stat.accent_border && "border-t-2 border-t-accent",
          ]}>
            <div class:list={[
              "font-display font-black text-[clamp(2rem,7vw,2.5rem)] leading-none mb-2",
              stat.accent ? "text-accent" : "text-text-primary",
            ]}>{stat.value}</div>
            <div class="text-label-size font-heading text-text-muted">{stat.label}</div>
            <p class="font-body text-[13px] text-text-secondary mt-2">{stat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
