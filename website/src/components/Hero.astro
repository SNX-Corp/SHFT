---
import { getEntry } from 'astro:content';
import Button from './Button.astro';
import Marquee from './Marquee.astro';

const entry = await getEntry('sections', 'hero');
const d = entry!.data as {
  eyebrow: string;
  headline_line_1: string;
  headline_line_2: string;
  headline_line_3: string;
  subtitle: string;
  partner: string;
  sponsor: string;
  cta_primary_label: string;
  cta_primary_href: string;
  cta_secondary_label: string;
  cta_secondary_href: string;
};
---

<section id="hero" class="hero-stage relative min-h-[100svh] flex flex-col bg-surface-alt" data-hero>
  <!-- MAIN STAGE -->
  <div class="relative flex-1 flex items-center justify-center overflow-hidden">
    <!-- Corner video triangles -->
    <div class="hero-tri hero-tri-left" aria-hidden="true">
      <video class="hero-tri-media" autoplay muted loop playsinline preload="metadata" poster="/videos/hero-left-poster.jpg">
        <source src="/videos/hero-left.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-tri hero-tri-right" aria-hidden="true">
      <video class="hero-tri-media" autoplay muted loop playsinline preload="metadata" poster="/videos/hero-right-poster.jpg">
        <source src="/videos/hero-right.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Invisible animation target retained so the existing GSAP sequence stays intact -->
    <div class="sr-only" data-hero-splash></div>

    <!-- Centered content. The big wordmark itself lives in the nav (it morphs up on scroll); this slot reserves its space. -->
    <div class="pointer-events-none relative z-[var(--z-hero-text)] content-width box-border max-w-full text-center" data-hero-copy>
      <div class="flex flex-col items-center">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-6 sm:mb-8" data-hero-eyebrow>
          <span class="block w-1.5 h-1.5 rounded-full bg-accent pulse-dot"></span>
          <span class="font-heading font-semibold text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-white/65">
            {d.eyebrow}
          </span>
        </div>

        <!-- Logo slot: the morphing wordmark sits centered here at rest -->
        <div class="hero-logo-slot" data-hero-logo-slot aria-hidden="true"></div>

        <!-- Tagline + credibility lines -->
        <div class="mt-8 sm:mt-10 flex flex-col items-center gap-3.5" data-hero-sub>
          <p class="font-heading font-medium text-[0.98rem] sm:text-[clamp(1rem,1.3vw,1.15rem)] text-white/70 max-w-xl leading-relaxed">
            {d.subtitle}
          </p>
          <div class="flex flex-col items-center gap-1.5 font-heading text-[11px] sm:text-[12px] font-semibold uppercase tracking-[0.18em] text-white/45">
            <span>Partnered with <span class="font-bold" style="color: #FF4242">{d.partner}</span></span>
            <span>Sponsored by <span class="font-bold" style="color: #4D7DFF">{d.sponsor}</span></span>
          </div>
        </div>

        <!-- CTA -->
        <div class="pointer-events-auto mt-8 sm:mt-10" data-hero-cta>
          <Button href={d.cta_primary_href} variant="primary" size="large" data-open-join-modal>{d.cta_primary_label}</Button>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-7 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 z-[6]" data-hero-scroll>
      <span class="font-heading text-[10px] uppercase tracking-[0.2em] text-white/35">Scroll</span>
      <div class="w-px h-10 bg-white/20 relative overflow-hidden">
        <div class="w-full h-4 bg-accent animate-[scrollDown_2s_ease-in-out_infinite]"></div>
      </div>
    </div>
  </div>

  <!-- MARQUEE: thin bottom band of the hero -->
  <Marquee />
</section>

<style>
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }
  .hero-logo-slot {
    height: var(--hero-logo-h, clamp(4.25rem, 16vh, 11rem));
    width: 1px;
  }

  /* Corner video triangles */
  .hero-tri {
    position: absolute;
    bottom: 0;
    width: 40%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .hero-tri-left {
    left: 0;
    clip-path: polygon(0 100%, 0 0, 100% 100%);
  }
  .hero-tri-right {
    right: 0;
    clip-path: polygon(100% 100%, 100% 0, 0 100%);
  }
  .hero-tri-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Crisp diagonal seam with a thin lime stroke along the inner edge.
     The 50% iso-line of a corner-anchored gradient tracks the clip hypotenuse at any
     viewport size, so a hard 2px band sits exactly on the cut. */
  .hero-tri::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-tri-left::after {
    background: linear-gradient(
      to top right,
      transparent calc(50% - 2px),
      var(--color-accent) calc(50% - 2px),
      var(--color-accent) 50%,
      transparent 50%
    );
  }
  .hero-tri-right::after {
    background: linear-gradient(
      to top left,
      transparent calc(50% - 2px),
      var(--color-accent) calc(50% - 2px),
      var(--color-accent) 50%,
      transparent 50%
    );
  }
  /* Desktop-only flourish: no corner videos on mobile / tablet */
  @media (max-width: 1023px) {
    .hero-tri { display: none; }
  }
</style>

<script>
  // Belt-and-suspenders: a few browsers defer muted autoplay until an explicit play() call.
  document.querySelectorAll<HTMLVideoElement>('.hero-tri-media').forEach((vid) => {
    vid.muted = true;
    const tryPlay = () => vid.play().catch(() => {});
    if (vid.readyState >= 2) tryPlay();
    vid.addEventListener('canplay', tryPlay, { once: true });
  });
</script>
