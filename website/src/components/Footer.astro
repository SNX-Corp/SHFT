---
import { social } from '../data/social';

const linkGroups = [
  {
    title: 'Team',
    links: [
      { label: 'About', href: '#about' },
      { label: 'Values', href: '#values' },
      { label: 'Members', href: '#team' },
      { label: 'Timeline', href: '#timeline' },
    ],
  },
  {
    title: 'Competition',
    links: [
      { label: 'The Robot', href: '#robot' },
      { label: 'Gallery', href: '#gallery' },
      { label: 'FRC', href: 'https://www.firstinspires.org/robotics/frc' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { label: 'Join the Team', href: '#recruit' },
      { label: 'Sponsor Us', href: '#sponsors' },
      { label: 'Brand Identity', href: '/brand' },
    ],
  },
];
---

<footer class="bg-surface-alt text-text-inverse">
  <!-- Main footer -->
  <div class="content-width py-16 lg:py-24">
    <!-- Top row: Wordmark + Social -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-12 mb-16">
      <div>
        <img
          src="/images/logo/wordmark.png"
          alt="Team SHIFT"
          class="h-10 lg:h-14 w-auto"
        />
        <p class="font-body text-[14px] text-white/30 mt-3 max-w-sm">
          SHIFT our mindset. ELEVATE our impact.
        </p>
      </div>

      <!-- Social links -->
      <div class="flex items-center gap-6">
        {social.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-white/40 hover:text-accent transition-colors duration-200 py-[13px] -my-[13px]"
          >
            {s.platform}
          </a>
        ))}
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 mb-16">
      {linkGroups.map((group) => (
        <div>
          <h4 class="font-heading font-bold text-[11px] uppercase tracking-[0.15em] text-white/30 mb-4">
            {group.title}
          </h4>
          <ul class="space-y-1">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-body text-[14px] text-white/60 hover:text-accent transition-colors duration-200 inline-block py-3"
                  {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-8 border-t border-white/10">
      <p class="font-body text-[12px] text-white/20">
        &copy; {new Date().getFullYear()} Team SHFT. All rights reserved.
      </p>
      <a
        href="#hero"
        class="font-heading text-[11px] font-semibold uppercase tracking-[0.15em] text-white/30 hover:text-accent transition-colors duration-200 py-[14px] -my-[14px]"
      >
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
