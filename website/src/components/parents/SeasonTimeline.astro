---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'timeline');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  intro: string;
  phases: Array<{
    period: string;
    title: string;
    description: string;
    intensity: 'low' | 'medium' | 'high';
  }>;
};

const intensityColors: Record<string, string> = {
  low: "bg-white/30",
  medium: "bg-accent/60",
  high: "bg-accent",
};

const intensityLabels: Record<string, string> = {
  low: "Ramp-up",
  medium: "Building",
  high: "Full intensity",
};
---

<section
  id="season"
  class="relative overflow-hidden bg-surface-alt text-text-inverse py-16 lg:py-0 lg:h-screen lg:flex lg:items-center"
  data-season
  data-no-reveal
>
  <!-- Static, dimmed workshop backdrop -->
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/parents/shiftlab2.png');"></div>
  <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(20,20,20,0.94) 0%, rgba(20,20,20,0.9) 45%, rgba(20,20,20,0.82) 100%);"></div>
  <div
    class="absolute inset-0 opacity-[0.05]"
    style="background-image: linear-gradient(rgba(255,255,255,.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.2) 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <div class="content-width relative w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-20 lg:items-center">
      <!-- LEFT: static heading -->
      <div>
        <SectionLabel number={d.section_number} text={d.section_label} inverted />

        <h2 class="font-display font-black text-h2-size mb-6">
          <span class="title-shine is-white">{d.headline_line_1}</span><br/>
          <span class="title-shine is-white delay-1">{d.headline_line_2}</span>
        </h2>

        <p class="font-body text-[16px] text-white/60 leading-relaxed max-w-md mb-6">
          {d.intro}
        </p>

        <div class="hidden lg:flex items-center gap-2 text-white/35">
          <span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em]">Scroll the season</span>
          <span class="text-[14px] leading-none animate-pulse">↓</span>
        </div>
      </div>

      <!-- RIGHT: timeline that scrolls within a fixed window while pinned -->
      <div class="relative lg:h-[64vh] lg:overflow-hidden" data-timeline-window>
        <!-- top/bottom fade masks (desktop only) -->
        <div class="hidden lg:block absolute inset-x-0 top-0 h-16 z-10 pointer-events-none" style="background: linear-gradient(rgba(20,20,20,0.95), transparent);"></div>
        <div class="hidden lg:block absolute inset-x-0 bottom-0 h-16 z-10 pointer-events-none" style="background: linear-gradient(transparent, rgba(20,20,20,0.95));"></div>

        <div class="relative pl-8 lg:pl-12 lg:py-10" data-timeline-track>
          <div class="absolute left-0 lg:left-4 top-0 bottom-0 w-px bg-white/15"></div>

          <div class="space-y-10 lg:space-y-12">
            {d.phases.map((phase) => (
              <div class="relative">
                <!-- Marker: lightning bolt centered on the line -->
                <div
                  class:list={[
                    "absolute top-[0.2rem] left-[-2rem] -translate-x-1/2 flex items-center justify-center w-[18px] h-[18px] rounded-full bg-[#161616]",
                    phase.intensity === 'high' ? 'text-accent' : phase.intensity === 'medium' ? 'text-accent/70' : 'text-white/45',
                  ]}
                  data-timeline-phase={phase.period}
                >
                  <svg class="w-[11px] h-[11px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                </div>

                <!-- Period badge -->
                <div class="flex items-center gap-3 mb-2">
                  <span class="font-display font-black text-[14px] text-white tracking-wide">{phase.period}</span>
                  <span class:list={[
                    "text-[10px] font-heading font-bold uppercase tracking-[0.15em] px-2.5 py-1",
                    phase.intensity === "high" ? "bg-accent text-accent-text" :
                    phase.intensity === "medium" ? "bg-accent/60 text-accent-text" :
                    "bg-white/15 text-white/75",
                  ]}>
                    {intensityLabels[phase.intensity]}
                  </span>
                </div>

                <h3 class="font-heading font-bold text-[1.25rem] text-white mb-2">{phase.title}</h3>
                <p class="font-body text-white/60 text-[15px] leading-relaxed max-w-xl">{phase.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // E: Highlight the timeline dot whose period covers today's month.
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  function periodCovers(period: string, currentIdx: number): boolean {
    const text = period.toUpperCase().trim();
    const range = text.match(/^([A-Z]{3,})\s*[-–]\s*([A-Z]{3,})$/);
    if (range) {
      const startIdx = months.indexOf(range[1].slice(0, 3));
      const endIdx = months.indexOf(range[2].slice(0, 3));
      if (startIdx < 0 || endIdx < 0) return false;
      if (startIdx <= endIdx) return currentIdx >= startIdx && currentIdx <= endIdx;
      return currentIdx >= startIdx || currentIdx <= endIdx;
    }
    const single = months.findIndex((m) => text.startsWith(m));
    return single === currentIdx;
  }
  const currentMonth = new Date().getMonth();
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-phase]'));
  const single: HTMLElement[] = [];
  const ranges: HTMLElement[] = [];
  dots.forEach((el) => {
    const period = (el.dataset.timelinePhase || '').toUpperCase();
    (period.includes('-') || period.includes('–') ? ranges : single).push(el);
  });
  for (const el of [...single, ...ranges]) {
    if (periodCovers(el.dataset.timelinePhase || '', currentMonth)) {
      el.classList.add('timeline-now');
      break;
    }
  }

  // Pin Section 6 on desktop; scroll the timeline track up through its window.
  const section = document.querySelector<HTMLElement>('[data-season]');
  const windowEl = document.querySelector<HTMLElement>('[data-timeline-window]');
  const track = document.querySelector<HTMLElement>('[data-timeline-track]');

  if (section && windowEl && track) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const distance = () => Math.max(0, track.scrollHeight - windowEl.clientHeight);
      const tween = gsap.to(track, {
        y: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => '+=' + distance(),
          scrub: 0.5,
          pin: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(track, { clearProps: 'transform' });
      };
    });
  }
</script>
