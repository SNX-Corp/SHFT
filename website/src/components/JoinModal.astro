---
import { getEntry } from 'astro:content';

const entry = await getEntry('sections', 'contact');
const d = entry!.data as {
  modal_eyebrow: string;
  modal_headline: string;
  modal_subtitle: string;
  contact_name: string;
  contact_role: string;
  contact_email: string;
  contact_phone: string;
};

// tel: links need the phone stripped to digits + leading + (if present)
const telHref = `tel:${d.contact_phone.replace(/[^\d+]/g, '')}`;
---

<div
  id="join-modal"
  class="fixed inset-0 z-[9999] pointer-events-none opacity-0 transition-opacity duration-300"
  data-join-modal
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="join-modal-headline"
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/75 backdrop-blur-sm" data-join-modal-backdrop></div>

  <!-- Card -->
  <div class="relative h-full flex items-center justify-center p-4 sm:p-6">
    <div
      class="relative w-full max-w-md bg-surface-alt text-text-inverse border border-white/10 shadow-[0_30px_80px_rgba(0,0,0,0.45)]"
      data-join-modal-card
    >
      <!-- Accent top edge -->
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent"></div>

      <!-- Close -->
      <button
        class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/5 transition-colors duration-150 cursor-pointer"
        aria-label="Close"
        data-join-modal-close
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 1l12 12M13 1L1 13"/>
        </svg>
      </button>

      <div class="p-7 sm:p-9 pt-10 sm:pt-11">
        <!-- Eyebrow -->
        <div class="flex items-center gap-2 mb-5">
          <span class="block w-1.5 h-1.5 rounded-full bg-accent pulse-dot"></span>
          <span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-accent">
            {d.modal_eyebrow}
          </span>
        </div>

        <!-- Headline -->
        <h3
          id="join-modal-headline"
          class="font-display font-black text-[clamp(1.6rem,4vw,2rem)] leading-[1] tracking-[-0.02em] text-white mb-3"
        >
          {d.modal_headline}
        </h3>

        <!-- Subtitle -->
        <p class="font-body text-[14px] text-white/55 leading-relaxed mb-7">
          {d.modal_subtitle}
        </p>

        <!-- Contact card: name + role -->
        <div class="flex items-center gap-3 mb-6 pb-5 border-b border-white/10">
          <div class="w-10 h-10 bg-accent text-accent-text font-display font-black text-[14px] flex items-center justify-center shrink-0">
            {d.contact_name.split(' ').map((p) => p[0]).join('').slice(0, 2)}
          </div>
          <div>
            <div class="font-heading font-bold text-[14px] text-white">{d.contact_name}</div>
            <div class="text-label-size font-heading text-text-muted">{d.contact_role}</div>
          </div>
        </div>

        <!-- Email row -->
        <a
          href={`mailto:${d.contact_email}`}
          class="group flex items-center justify-between gap-3 py-4 border-b border-white/10 hover:border-accent/40 transition-colors duration-150"
        >
          <div class="flex items-center gap-3 min-w-0">
            <svg class="w-4 h-4 text-white/40 group-hover:text-accent shrink-0 transition-colors duration-150" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="1.5" y="3" width="13" height="10" rx="1"/>
              <path d="M2 4l6 5 6-5"/>
            </svg>
            <div class="min-w-0">
              <div class="text-label-size font-heading text-text-muted mb-0.5">Email</div>
              <div class="font-body text-[14px] text-white truncate">{d.contact_email}</div>
            </div>
          </div>
          <button
            type="button"
            class="font-heading text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 hover:text-accent transition-colors duration-150 px-2.5 py-2 cursor-pointer"
            data-copy={d.contact_email}
            onclick="event.preventDefault();event.stopPropagation();"
            aria-label="Copy email"
          >
            <span data-copy-label>Copy</span>
          </button>
        </a>

        <!-- Phone row -->
        <a
          href={telHref}
          class="group flex items-center justify-between gap-3 py-4 hover:border-accent/40 transition-colors duration-150"
        >
          <div class="flex items-center gap-3 min-w-0">
            <svg class="w-4 h-4 text-white/40 group-hover:text-accent shrink-0 transition-colors duration-150" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 2.5h2.5l1 3-1.5 1c.8 1.8 2.2 3.2 4 4l1-1.5 3 1V13c0 .3-.2.5-.5.5C7 13.5 2.5 9 2.5 3c0-.3.2-.5.5-.5z"/>
            </svg>
            <div class="min-w-0">
              <div class="text-label-size font-heading text-text-muted mb-0.5">Phone / SMS</div>
              <div class="font-body text-[14px] text-white truncate">{d.contact_phone}</div>
            </div>
          </div>
          <button
            type="button"
            class="font-heading text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 hover:text-accent transition-colors duration-150 px-2.5 py-2 cursor-pointer"
            data-copy={d.contact_phone}
            onclick="event.preventDefault();event.stopPropagation();"
            aria-label="Copy phone"
          >
            <span data-copy-label>Copy</span>
          </button>
        </a>

        <!-- Footnote -->
        <p class="font-body text-[11px] text-white/35 mt-6 text-center">
          Tap email or phone to open directly. Or just copy and paste.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-join-modal]');
  const card = document.querySelector<HTMLElement>('[data-join-modal-card]');
  const backdrop = document.querySelector<HTMLElement>('[data-join-modal-backdrop]');
  const closeBtn = document.querySelector<HTMLElement>('[data-join-modal-close]');
  const triggers = document.querySelectorAll<HTMLElement>('[data-open-join-modal]');
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');

  if (!modal || !card || !backdrop || !closeBtn) {
    // no modal on this page, so bail
  } else {
    let lastFocused: HTMLElement | null = null;

    function openModal(triggerEl?: HTMLElement) {
      if (!modal) return;
      lastFocused = triggerEl || (document.activeElement as HTMLElement);
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Subtle scale-in on the card
      if (card) {
        card.style.transform = 'translateY(8px) scale(0.98)';
        card.style.opacity = '0';
        card.style.transition = 'transform 280ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease-out';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            card.style.transform = 'translateY(0) scale(1)';
            card.style.opacity = '1';
          });
        });
      }
      // Focus the close button for keyboard users
      setTimeout(() => closeBtn?.focus(), 200);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0');
      modal.classList.remove('opacity-100');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Restore pointer-events after the fade-out so clicks beneath stay normal
      setTimeout(() => {
        modal.classList.add('pointer-events-none');
      }, 300);
      lastFocused?.focus?.();
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(trigger);
      });
    });

    backdrop.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });

    // Copy buttons
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const value = btn.dataset.copy || '';
        const label = btn.querySelector<HTMLElement>('[data-copy-label]');
        try {
          await navigator.clipboard.writeText(value);
          if (label) {
            const original = label.textContent;
            label.textContent = 'Copied';
            btn.classList.add('text-accent');
            setTimeout(() => {
              if (label) label.textContent = original;
              btn.classList.remove('text-accent');
            }, 1400);
          }
        } catch {
          // Fallback: just briefly show "Copy failed"
          if (label) {
            const original = label.textContent;
            label.textContent = 'Copy failed';
            setTimeout(() => { if (label) label.textContent = original; }, 1400);
          }
        }
      });
    });
  }
</script>
