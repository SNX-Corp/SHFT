---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connect - Team SHFT"
  description="Save our contact, see the sponsor package, and reach Team SHFT."
  showJoinModal={false}
  preloader={false}
>
  <div class="min-h-screen bg-surface-alt text-text-inverse flex flex-col items-center px-6 py-14">
    <main class="w-full max-w-[420px] flex flex-col items-center">
      <img src="/images/logo/wordmark.png" alt="Team SHFT" class="w-[240px] h-auto" />
      <p class="font-body text-[15px] text-white/55 text-center mt-5 leading-relaxed">
        Community FIRST Robotics team in North York.
        Good to meet you. Everything you need is below.
      </p>

      <nav class="w-full flex flex-col gap-3 mt-9">
        <a
          href="/sponsor-package.pdf"
          target="_blank"
          class="block bg-accent text-accent-text text-center font-heading font-bold uppercase tracking-[0.14em] text-[14px] py-4 px-6 active:scale-[0.97] transition-transform"
          >Sponsor package</a
        >
        <div class="grid grid-cols-2 gap-3">
          <a
            href="/sponsor-package.pdf"
            download="SHFT-Sponsor-Package.pdf"
            class="block border border-white/25 text-white text-center font-heading font-semibold uppercase tracking-[0.14em] text-[12px] py-3 px-2 hover:border-accent hover:text-accent transition-colors"
            >Download PDF</a
          >
          <button
            id="share-btn"
            class="border border-white/25 text-white font-heading font-semibold uppercase tracking-[0.14em] text-[12px] py-3 px-2 hover:border-accent hover:text-accent transition-colors cursor-pointer"
            >Share this page</button
          >
        </div>

        <a
          href="/shft-contact.vcf"
          class="block border-2 border-accent text-accent text-center font-heading font-bold uppercase tracking-[0.14em] text-[14px] py-4 px-6 mt-3 active:scale-[0.97] transition-transform"
          >Save our contact</a
        >
        <a
          href="tel:+16478786114"
          class="block border border-white/25 text-white text-center font-heading font-semibold uppercase tracking-[0.14em] text-[13px] py-4 px-6 hover:border-accent hover:text-accent transition-colors"
          >Call or text +1 (647) 878-6114</a
        >
        <a
          href="mailto:team@shftrobotics.com"
          class="block border border-white/25 text-white text-center font-heading font-semibold uppercase tracking-[0.14em] text-[13px] py-4 px-6 hover:border-accent hover:text-accent transition-colors"
          >team@shftrobotics.com</a
        >
        <a
          href="https://www.instagram.com/shftrobotics/"
          target="_blank"
          rel="noopener"
          class="block border border-white/25 text-white text-center font-heading font-semibold uppercase tracking-[0.14em] text-[13px] py-4 px-6 hover:border-accent hover:text-accent transition-colors"
          >Instagram @shftrobotics</a
        >
        <a
          href="/"
          class="block text-center font-heading font-semibold uppercase tracking-[0.16em] text-[12px] text-white/40 hover:text-accent transition-colors py-3"
          >shftrobotics.com →</a
        >
      </nav>
    </main>
    <footer class="mt-auto pt-12 font-heading text-[11px] uppercase tracking-[0.2em] text-white/30">
      Shft the standard.
    </footer>
  </div>

  <script>
    const btn = document.getElementById('share-btn');
    btn?.addEventListener('click', async () => {
      const data = {
        title: 'SHFT Robotics',
        text: 'SHFT Robotics sponsor package and contact',
        url: 'https://shftrobotics.com/connect',
      };
      if (navigator.share) {
        try {
          await navigator.share(data);
        } catch {
          /* user cancelled */
        }
      } else {
        await navigator.clipboard.writeText(data.url);
        btn.textContent = 'Link copied';
        setTimeout(() => (btn.textContent = 'Share this page'), 2000);
      }
    });
  </script>
</BaseLayout>
