---
import SectionLabel from './SectionLabel.astro';
---

<section id="about" class="py-24 lg:py-40 bg-bg">
  <div class="content-width">
    <SectionLabel number="01" text="ABOUT" />

    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-20 items-start">
      <!-- Left: Big statement -->
      <div>
        <h2 data-about-heading class="font-display font-black text-h1-size text-text-primary leading-[0.95]">
          NOT YOUR<br />
          <span class="text-accent">AVERAGE</span><br />
          ROBOTICS<br />
          TEAM.
        </h2>
      </div>

      <!-- Right: Description with green accent line -->
      <div data-about-text class="relative pl-4 lg:pl-6 border-l-2 border-accent">
        <p class="font-body text-text-secondary text-[clamp(1rem,1.5vw,1.125rem)] leading-[1.7] mb-6">
          Team SHFT isn't a club that meets on Tuesdays. We're a competitive engineering program that designs, builds, and programs a 120-pound robot from the ground up — then takes it into battle against the best teams in the world.
        </p>
        <p class="font-body text-text-secondary text-[clamp(1rem,1.5vw,1.125rem)] leading-[1.7]">
          Founded in 2025, we operate like a startup: subteams own their domains, deadlines are real, and every member ships something. Mechanical, electrical, programming, business, media — every role matters.
        </p>
      </div>
    </div>

    <!-- Metrics strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-20 pt-12 border-t border-border">
      <div data-about-metric>
        <div class="w-5 h-[2px] bg-accent mb-4"></div>
        <div class="font-display font-black text-[2rem] text-text-primary tracking-tight">2025</div>
        <div class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-text-muted mt-1">Est.</div>
      </div>
      <div data-about-metric>
        <div class="w-5 h-[2px] bg-accent mb-4"></div>
        <div class="font-display font-black text-[2rem] text-text-primary tracking-tight">FRC</div>
        <div class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-text-muted mt-1">Competition</div>
      </div>
      <div data-about-metric>
        <div class="w-5 h-[2px] bg-accent mb-4"></div>
        <div class="font-display font-black text-[2rem] text-text-primary tracking-tight">Rookie</div>
        <div class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-text-muted mt-1">Team Status</div>
      </div>
      <div data-about-metric>
        <div class="w-5 h-[2px] bg-accent mb-4"></div>
        <div class="font-display font-black text-[2rem] text-text-primary tracking-tight">∞</div>
        <div class="font-heading text-[12px] font-semibold uppercase tracking-[0.1em] text-text-muted mt-1">Ambition</div>
      </div>
    </div>
  </div>
</section>
