---
interface Props {
  number: string;
  text: string;
  inverted?: boolean;
}

const { number, text } = Astro.props;
---

<div class="flex items-center gap-3 mb-12">
  <span class="w-8 h-px bg-accent shrink-0" aria-hidden="true"></span>
  <span class="flex items-center gap-2 text-label-size font-heading text-text-muted">
    <span>{number}</span>
    <span class="opacity-60" aria-hidden="true">&middot;</span>
    <span>{text}</span>
  </span>
</div>
