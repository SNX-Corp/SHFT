---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'mentors');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  mentors: Array<{
    name: string;
    role_tagline: string;
    bio_1: string;
    bio_2: string;
    quote: string;
    credentials: Array<{ label: string; value: string }>;
  }>;
};

function initials(name: string): string {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---

<section id="lead-e" class="duo-section">
  <div class="content-width">
    <SectionLabel number={d.section_number} text={d.section_label} />

    <div class="duo-heading">
      <h2 class="font-display font-black text-h2-size">
        <span class="title-shine is-dark delay-1">{d.headline_line_1}</span><br />
        <span class="title-shine is-dark delay-2">{d.headline_line_2}</span>
      </h2>
      <p class="duo-subline font-body">
        Two perspectives. One mission. Built to take you further.
      </p>
    </div>

    <div class="duo-grid">
      {d.mentors.map((mentor) => (
        <article class="duo-card">

          <!-- Portrait placeholder header -->
          <div class="duo-card__portrait" aria-hidden="true">
            <!-- Subtle grid texture overlay -->
            <div class="portrait-grid" />

            <!-- Initials medallion -->
            <div class="portrait-medallion">
              <span class="medallion-initials font-display">{initials(mentor.name)}</span>
            </div>

            <!-- Lime accent bar -->
            <div class="portrait-bar" />
          </div>

          <!-- Identity strip -->
          <div class="duo-card__identity">
            <h3 class="identity-name font-display font-black">{mentor.name.toUpperCase()}</h3>
            <span class="identity-role font-heading text-label-size">{mentor.role_tagline.toUpperCase()}</span>
          </div>

          <!-- Card body -->
          <div class="duo-card__body">

            <!-- Bios -->
            <div class="duo-bios">
              <p class="bio-primary font-body">{mentor.bio_1}</p>
              <p class="bio-secondary font-body">{mentor.bio_2}</p>
            </div>

            <!-- Quote block -->
            <blockquote class="duo-quote">
              <span class="quote-mark font-display" aria-hidden="true">"</span>
              <p class="quote-text font-heading">{mentor.quote}</p>
            </blockquote>

            <!-- Credentials grid -->
            <div class="duo-credentials" role="list">
              {mentor.credentials.map((item) => (
                <div class="cred-item" role="listitem">
                  <dt class="cred-label font-heading text-label-size">{item.label}</dt>
                  <dd class="cred-value font-heading">{item.value}</dd>
                </div>
              ))}
            </div>

          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section shell ── */
  .duo-section {
    padding-block: 5rem;
    background-color: var(--color-surface);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .duo-section {
      padding-block: 7rem;
    }
  }

  /* ── Heading block ── */
  .duo-heading {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .duo-heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.5rem;
      margin-bottom: 4rem;
    }
  }

  .duo-subline {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    max-width: 26ch;
    flex-shrink: 0;
    padding-bottom: 0.25rem;
  }

  /* ── 2-column card grid ── */
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .duo-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  /* ── Card shell ── */
  .duo-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06), 0 0 0 0 rgba(166, 255, 0, 0);
    transition: box-shadow 300ms ease, border-color 300ms ease;
    display: flex;
    flex-direction: column;
  }

  .duo-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10), 0 0 0 1px rgba(166, 255, 0, 0.35);
    border-color: rgba(166, 255, 0, 0.4);
  }

  /* ── Portrait placeholder ── */
  .duo-card__portrait {
    position: relative;
    height: 14rem;
    background-color: var(--color-surface-alt);
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .duo-card__portrait {
      height: 16rem;
    }
  }

  /* Subtle dot-grid texture */
  .portrait-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(166, 255, 0, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.7;
  }

  /* Diagonal lime accent band at top-right corner */
  .portrait-grid::after {
    content: '';
    position: absolute;
    top: -4rem;
    right: -4rem;
    width: 14rem;
    height: 14rem;
    background: linear-gradient(135deg, rgba(166, 255, 0, 0.12) 0%, transparent 65%);
    border-radius: 50%;
  }

  /* Initials medallion centered */
  .portrait-medallion {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .medallion-initials {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 900;
    color: rgba(255, 255, 255, 0.06);
    letter-spacing: -0.04em;
    line-height: 1;
    user-select: none;
  }

  /* Lime accent bar at portrait bottom */
  .portrait-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-accent);
  }

  /* ── Identity strip ── */
  .duo-card__identity {
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .identity-name {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .identity-role {
    color: var(--color-accent-dim);
    display: block;
  }

  /* ── Card body ── */
  .duo-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }

  /* ── Bios ── */
  .duo-bios {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bio-primary {
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .bio-secondary {
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* ── Quote block ── */
  .duo-quote {
    position: relative;
    background-color: var(--color-surface);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem 1rem 1rem;
    margin: 0;
    overflow: hidden;
  }

  .duo-quote::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(166, 255, 0, 0.06) 0%, transparent 60%);
  }

  .quote-mark {
    position: absolute;
    top: -0.5rem;
    right: 0.75rem;
    font-size: 4rem;
    font-weight: 900;
    color: rgba(166, 255, 0, 0.15);
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .quote-text {
    position: relative;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.65;
    color: var(--color-text-primary);
    font-style: italic;
    margin: 0;
  }

  /* ── Credentials ── */
  .duo-credentials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  .cred-item {
    padding: 0.625rem 0.5rem 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Remove border from the last two items (bottom row) */
  .cred-item:nth-last-child(-n+2) {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Right column items get a left separator */
  .cred-item:nth-child(even) {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
  }

  .cred-label {
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.625rem;
  }

  .cred-value {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin: 0;
  }
</style>
