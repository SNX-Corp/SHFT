---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'mentors');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  mentors: Array<{
    name: string;
    role_tagline: string;
    bio_1: string;
    bio_2: string;
    quote: string;
    credentials: Array<{ label: string; value: string }>;
  }>;
};

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('');
}
---

<section id="lead-a" class="option-a-section">
  <div class="content-width">

    <!-- Section header -->
    <div class="option-a-header">
      <SectionLabel number={d.section_number} text={d.section_label} />
      <h2 class="font-display font-black text-h2-size option-a-headline">
        <span class="title-shine is-dark delay-1">{d.headline_line_1}</span><br />
        <span class="title-shine is-dark delay-2">{d.headline_line_2}</span>
      </h2>
    </div>

    <!-- Mentor cards -->
    {d.mentors.map((mentor, i) => {
      const flipped = i % 2 === 1;
      const initials = getInitials(mentor.name);
      return (
        <article class:list={['option-a-mentor', i > 0 && 'option-a-mentor--divided']}>
          <div class:list={['option-a-inner', flipped && 'option-a-inner--flipped']}>

            <!-- Portrait column -->
            <div class="option-a-portrait-col">
              <div class="option-a-portrait">
                <!-- Lime accent edge -->
                <div class="option-a-portrait-edge" />

                <!-- Initials -->
                <div class="option-a-portrait-body">
                  <span class="option-a-initials font-display">{initials}</span>
                  <div class="option-a-portrait-name">
                    <span class="option-a-portrait-fullname font-display">{mentor.name.toUpperCase()}</span>
                    <span class="option-a-portrait-role font-heading text-label-size">{mentor.role_tagline.toUpperCase()}</span>
                  </div>
                </div>

                <!-- Corner accent dot -->
                <div class="option-a-corner-dot" />
              </div>
            </div>

            <!-- Content column -->
            <div class="option-a-content-col">

              <!-- Name + role header -->
              <header class="option-a-content-header">
                <h3 class="option-a-name font-display">{mentor.name}</h3>
                <p class="option-a-role font-heading text-label-size">{mentor.role_tagline}</p>
              </header>

              <!-- Bio paragraphs -->
              <div class="option-a-bio">
                <p class="font-body">{mentor.bio_1}</p>
                <p class="font-body">{mentor.bio_2}</p>
              </div>

              <!-- Pull quote -->
              <blockquote class="option-a-quote">
                <div class="option-a-quote-rule" />
                <p class="font-body option-a-quote-text">"{mentor.quote}"</p>
              </blockquote>

              <!-- Credentials definition list -->
              <dl class="option-a-credentials">
                {mentor.credentials.map((item) => (
                  <div class="option-a-cred-row">
                    <dt class="option-a-cred-label font-heading text-label-size">{item.label}</dt>
                    <dd class="option-a-cred-value font-heading">{item.value}</dd>
                  </div>
                ))}
              </dl>

            </div>
          </div>
        </article>
      );
    })}

  </div>
</section>

<style>
  /* ─── Section shell ─── */
  .option-a-section {
    background-color: var(--color-surface);
    padding-block: 5rem;
  }

  @media (min-width: 1024px) {
    .option-a-section {
      padding-block: 7.5rem;
    }
  }

  /* ─── Header ─── */
  .option-a-header {
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .option-a-header {
      margin-bottom: 5.5rem;
    }
  }

  .option-a-headline {
    margin-top: 0;
  }

  /* ─── Mentor article wrapper ─── */
  .option-a-mentor {
    /* no extra margin on first */
  }

  .option-a-mentor--divided {
    margin-top: 5rem;
    padding-top: 5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 1024px) {
    .option-a-mentor--divided {
      margin-top: 7rem;
      padding-top: 7rem;
    }
  }

  /* ─── Two-column grid ─── */
  .option-a-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .option-a-inner {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
      align-items: start;
    }

    /* Flipped: portrait on right, content on left */
    .option-a-inner--flipped {
      grid-template-columns: 7fr 5fr;
    }

    .option-a-inner--flipped .option-a-portrait-col {
      order: 2;
    }

    .option-a-inner--flipped .option-a-content-col {
      order: 1;
    }
  }

  /* ─── Portrait column ─── */
  .option-a-portrait {
    position: relative;
    background-color: var(--color-surface-alt);
    /* Elegant tall aspect on mobile, slightly wider on desktop */
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Lime accent left edge */
  .option-a-portrait-edge {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 3px;
    background-color: var(--color-accent);
  }

  /* Initials watermark */
  .option-a-initials {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    font-size: clamp(5rem, 16vw, 9rem);
    font-weight: 900;
    color: rgba(255, 255, 255, 0.04);
    letter-spacing: -0.04em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  /* Bottom name block */
  .option-a-portrait-body {
    position: relative;
    z-index: 1;
    padding: 1.5rem 1.5rem 1.5rem 2rem; /* compensate for the 3px edge */
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, 0.92) 0%,
      rgba(26, 26, 26, 0.6) 60%,
      transparent 100%
    );
  }

  .option-a-portrait-name {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .option-a-portrait-fullname {
    font-size: 1.125rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .option-a-portrait-role {
    color: var(--color-accent);
    line-height: 1;
  }

  /* Corner accent dot */
  .option-a-corner-dot {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    opacity: 0.7;
  }

  /* ─── Content column ─── */
  .option-a-content-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .option-a-content-col {
      gap: 2.5rem;
      padding-top: 0.5rem;
    }
  }

  /* ─── Content header ─── */
  .option-a-content-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .option-a-name {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }

  .option-a-role {
    color: var(--color-accent-dim);
    margin: 0;
  }

  /* ─── Bio ─── */
  .option-a-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .option-a-bio p {
    font-size: var(--text-small);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (min-width: 768px) {
    .option-a-bio p {
      font-size: var(--text-body);
    }
  }

  /* ─── Pull quote ─── */
  .option-a-quote {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .option-a-quote-rule {
    width: 2.5rem;
    height: 2px;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .option-a-quote-text {
    font-size: clamp(1rem, 1.75vw, 1.1875rem);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.6;
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* ─── Credentials ─── */
  .option-a-credentials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .option-a-credentials {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .option-a-cred-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 0.75rem 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Hairline vertical dividers between columns */
  .option-a-credentials {
    column-gap: 0;
  }

  .option-a-cred-row:nth-child(2n) {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .option-a-cred-row:nth-child(2n) {
      padding-left: 0;
      border-left: none;
    }

    .option-a-cred-row:nth-child(3n+2) {
      padding-inline: 0.75rem;
      border-inline: 1px solid var(--color-border);
    }

    .option-a-cred-row:nth-child(3n+3) {
      padding-left: 0.75rem;
    }
  }

  .option-a-cred-label {
    color: var(--color-text-muted);
    line-height: 1;
    display: block;
  }

  .option-a-cred-value {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.35;
    display: block;
  }

  @media (min-width: 768px) {
    .option-a-cred-value {
      font-size: var(--text-body);
    }
  }
</style>
