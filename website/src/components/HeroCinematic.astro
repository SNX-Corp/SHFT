---
import { getEntry } from 'astro:content';
import Button from './Button.astro';
import Marquee from './Marquee.astro';

const entry = await getEntry('sections', 'hero');
const d = entry!.data as {
  eyebrow: string;
  subtitle: string;
  partner: string;
  sponsor: string;
  cta_primary_label: string;
  cta_primary_href: string;
};
---

<section id="hero" class="hero-stage relative min-h-[100svh] flex flex-col bg-surface-alt" data-hero>
  <!-- MAIN STAGE -->
  <div class="relative flex-1 flex items-center justify-center overflow-hidden">
    <!-- Full-bleed background video -->
    <video class="hero-bg-media" autoplay muted loop playsinline preload="metadata" poster="/videos/hero-left-poster.jpg" aria-hidden="true">
      <source src="/videos/hero-left.mp4" type="video/mp4" />
    </video>
    <!-- Readability scrim: darkens the centre (behind the copy) + top/bottom, keeps the edges of the video alive -->
    <div class="hero-scrim" aria-hidden="true"></div>

    <!-- Invisible animation target retained so the existing GSAP sequence stays intact -->
    <div class="sr-only" data-hero-splash></div>

    <!-- Centered content: the wordmark is the vertical centrepiece (middle grid
         row sits at 50%); the maple-leaf crest hugs it above, the copy below. -->
    <div
      class="hero-readable absolute inset-0 z-[var(--z-hero-text)] content-width box-border max-w-full grid grid-rows-[1fr_auto_1fr] justify-items-center text-center pointer-events-none"
      data-hero-copy
    >
      <!-- Crest: maple leaf + eyebrow, hugging the wordmark from above -->
      <div class="self-end flex flex-col items-center gap-3 pb-8 sm:pb-10" data-hero-eyebrow>
        <img
          src="/images/maple-leaf.png"
          alt=""
          aria-hidden="true"
          class="h-[27px] w-auto"
          style="filter: drop-shadow(0 1px 6px rgba(0,0,0,0.5));"
        />
        <div class="flex items-center justify-center gap-3">
          <span class="block w-1.5 h-1.5 rounded-full bg-accent pulse-dot"></span>
          <span class="font-heading font-semibold text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-white/80">
            {d.eyebrow}
          </span>
          <span class="block w-1.5 h-1.5 rounded-full invisible" aria-hidden="true"></span>
        </div>
      </div>

      <!-- Logo slot: the morphing wordmark sits centred here at rest -->
      <div class="hero-logo-slot" data-hero-logo-slot aria-hidden="true"></div>

      <!-- Copy: tagline + credibility strip + CTA, hugging the wordmark from below (tight, lifted) -->
      <div class="self-start flex flex-col items-center pt-3 sm:pt-4">
        <div class="flex flex-col items-center gap-3" data-hero-sub>
          <p class="font-heading font-medium text-[0.98rem] sm:text-[clamp(1rem,1.3vw,1.15rem)] text-white/85 max-w-xl leading-relaxed">
            {d.subtitle}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-heading text-[10.5px] sm:text-[11.5px] font-semibold uppercase tracking-[0.22em] text-white/55">
            <span>Partnered with <span class="font-bold tracking-[0.14em]" style="color: #FF5A5A">{d.partner}</span></span>
            <span class="hidden sm:block h-3 w-px bg-white/25" aria-hidden="true"></span>
            <span>Sponsored by <span class="font-bold tracking-[0.14em]" style="color: #6E97FF">{d.sponsor}</span></span>
          </div>
        </div>
        <div class="pointer-events-auto mt-5" data-hero-cta>
          <Button href={d.cta_primary_href} variant="outline-accent" size="large" class="backdrop-blur-[2px]" data-open-join-modal>{d.cta_primary_label}</Button>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-7 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 z-[6]" data-hero-scroll>
      <span class="font-heading text-[10px] uppercase tracking-[0.2em] text-white/50">Scroll</span>
      <div class="w-px h-10 bg-white/25 relative overflow-hidden">
        <div class="w-full h-4 bg-accent animate-[scrollDown_2s_ease-in-out_infinite]"></div>
      </div>
    </div>
  </div>

  <!-- MARQUEE: thin bottom band of the hero -->
  <Marquee />
</section>

<style>
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }
  .hero-logo-slot {
    height: var(--hero-logo-h, clamp(4.75rem, 18vh, 12.5rem));
    width: 1px;
  }

  /* Full-bleed background video, dimmed so white copy reads cleanly over it */
  .hero-bg-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: brightness(0.66) saturate(1.04) contrast(1.04);
  }

  /* Scrim: a soft dark pool behind the centred copy + top/bottom falloff */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 82% 72% at 50% 44%, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.14) 66%, rgba(0, 0, 0, 0) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.08) 30%, rgba(0, 0, 0, 0.16) 64%, rgba(0, 0, 0, 0.5) 100%);
  }

  /* Belt-and-suspenders legibility: a faint shadow so text never melts into a bright frame */
  .hero-readable :is(p, span) {
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  // Belt-and-suspenders: a few browsers defer muted autoplay until an explicit play() call.
  document.querySelectorAll<HTMLVideoElement>('.hero-bg-media').forEach((vid) => {
    vid.muted = true;
    const tryPlay = () => vid.play().catch(() => {});
    if (vid.readyState >= 2) tryPlay();
    vid.addEventListener('canplay', tryPlay, { once: true });
  });
</script>
