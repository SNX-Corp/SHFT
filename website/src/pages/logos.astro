---
import BaseLayout from '../layouts/BaseLayout.astro';
import SMark from '../components/brand/SMark.astro';
---

<BaseLayout title="Brand Marks - Team SHFT">
  <div class="min-h-screen bg-surface-alt text-text-inverse">
    <div class="content-width pt-16 pb-10">
      <a href="/" class="font-heading text-[12px] font-semibold uppercase tracking-[0.15em] text-white/30 hover:text-accent transition-colors">← Back to site</a>
      <h1 class="font-display font-black text-h1-size mt-6 mb-3 italic">BRAND MARKS.</h1>
      <p class="font-body text-[15px] text-white/50 max-w-xl">The official Team SHFT marks - primary S-mark and the SHFT wordmark.</p>
    </div>

    <!-- Primary S-Mark -->
    <div class="content-width pt-12 pb-4 flex items-baseline gap-4">
      <span class="font-display font-black text-[28px] italic text-accent">01</span>
      <h3 class="font-heading font-bold text-[20px]">Primary Logo - S-Mark</h3>
    </div>
    <div class="bg-[#0d0d0d] border-y border-white/10 py-20 flex items-center justify-center gap-16 flex-wrap">
      <SMark size="190px" mode="dark" />
      <SMark size="104px" mode="dark" />
      <SMark size="52px" mode="dark" />
    </div>
    <div class="bg-white py-16 flex items-center justify-center gap-16 flex-wrap">
      <SMark size="140px" mode="light" />
      <SMark size="64px" mode="light" />
    </div>

    <!-- Wordmark -->
    <div class="content-width pt-16 pb-4 flex items-baseline gap-4">
      <span class="font-display font-black text-[28px] italic text-accent">02</span>
      <h3 class="font-heading font-bold text-[20px]">Wordmark</h3>
    </div>
    <div class="bg-[#0d0d0d] border-y border-white/10 py-20 px-10 flex items-center justify-center">
      <img src="/images/logo/wordmark.png" alt="Team SHFT" class="w-[min(540px,80vw)] h-auto" />
    </div>
    <div class="bg-white py-16 px-10 flex items-center justify-center">
      <img src="/images/logo/wordmark-dark.png" alt="Team SHFT" class="w-[min(420px,70vw)] h-auto" />
    </div>
    <div class="content-width py-6 flex items-center gap-6 border-b border-white/10">
      <span class="font-heading text-[10px] uppercase tracking-[0.15em] text-white/30 shrink-0">Small →</span>
      <img src="/images/logo/wordmark.png" alt="Team SHFT" class="h-5 w-auto" />
    </div>

    <div class="content-width py-16">
      <p class="font-body text-[13px] text-white/30">Built from the supplied vector + image files - wired into the nav, footer, favicon, and brand page.</p>
    </div>
  </div>
</BaseLayout>
