---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'mentors');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  mentors: Array<{
    name: string;
    role_tagline: string;
    bio_1: string;
    bio_2: string;
    quote: string;
    credentials: Array<{ label: string; value: string }>;
  }>;
};

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---

<section id="lead-c" class="py-16 lg:py-28 bg-surface-alt text-text-inverse">
  <div class="content-width">

    <!-- Section label -->
    <SectionLabel number={d.section_number} text={d.section_label} inverted />

    <!-- Section heading -->
    <div class="mb-14 lg:mb-20">
      <h2 class="font-display font-black text-h2-size leading-none tracking-tight">
        <span class="title-shine is-white delay-1">{d.headline_line_1}</span><br />
        <span class="title-shine is-accent delay-2">{d.headline_line_2}</span>
      </h2>
    </div>

    <!-- Dossier cards -->
    <div class="dossier-stack">
      {d.mentors.map((mentor) => {
        const initials = getInitials(mentor.name);
        return (
          <article class="dossier-card">

            <!-- Top lime rule -->
            <div class="dossier-top-rule" aria-hidden="true"></div>

            <!-- Card header: portrait + identity -->
            <div class="dossier-header">

              <!-- Portrait placeholder -->
              <div class="portrait-wrap" aria-hidden="true">
                <!-- Corner tick marks -->
                <span class="tick tick-tl" />
                <span class="tick tick-tr" />
                <span class="tick tick-bl" />
                <span class="tick tick-br" />

                <!-- Initials block -->
                <div class="portrait-inner">
                  <div class="portrait-initials">{initials}</div>
                  <div class="portrait-scan" aria-hidden="true"></div>
                </div>
              </div>

              <!-- Name + role -->
              <div class="identity-block">
                <div class="dossier-meta-row">
                  <span class="dossier-meta-chip">DOSSIER</span>
                  <span class="dossier-meta-sep" aria-hidden="true">/</span>
                  <span class="dossier-meta-text">SHFT LEADERSHIP</span>
                </div>
                <h3 class="dossier-name">{mentor.name.toUpperCase()}</h3>
                <div class="dossier-role-tag">
                  <span class="role-accent-pip" aria-hidden="true"></span>
                  {mentor.role_tagline.toUpperCase()}
                </div>
              </div>

            </div>

            <!-- Divider -->
            <div class="dossier-divider" aria-hidden="true"></div>

            <!-- Body: bio + quote + spec sheet -->
            <div class="dossier-body">

              <!-- Bios -->
              <div class="bio-block">
                <p class="bio-text">{mentor.bio_1}</p>
                <p class="bio-text">{mentor.bio_2}</p>

                <!-- Quote -->
                <blockquote class="dossier-quote">
                  <span class="quote-mark" aria-hidden="true">"</span>
                  {mentor.quote}
                  <span class="quote-mark" aria-hidden="true">"</span>
                </blockquote>
              </div>

              <!-- Spec sheet -->
              <div class="spec-sheet" aria-label={`${mentor.name} credentials`}>
                <div class="spec-header">
                  <span class="spec-header-text">SPEC SHEET</span>
                  <span class="spec-header-line" aria-hidden="true"></span>
                </div>
                <table class="spec-table">
                  <tbody>
                    {mentor.credentials.map((cred) => (
                      <tr class="spec-row">
                        <td class="spec-label">{cred.label}</td>
                        <td class="spec-value">{cred.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

            </div>

          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* ── Layout ───────────────────────────────────────────── */
  .dossier-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Dossier card ─────────────────────────────────────── */
  .dossier-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(255, 255, 255, 0.025);
    margin-bottom: 2px; /* hairline gap between cards */
  }

  /* Lime top rule */
  .dossier-top-rule {
    height: 2px;
    background: #A6FF00;
    width: 100%;
  }

  /* ── Header row ───────────────────────────────────────── */
  .dossier-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1.5rem 0;
  }

  @media (min-width: 640px) {
    .dossier-header {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
      padding: 2rem 2rem 0;
    }
  }

  /* ── Portrait ─────────────────────────────────────────── */
  .portrait-wrap {
    position: relative;
    flex-shrink: 0;
    width: 88px;
    height: 110px;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 640px) {
    .portrait-wrap {
      width: 104px;
      height: 130px;
    }
  }

  @media (min-width: 1024px) {
    .portrait-wrap {
      width: 120px;
      height: 150px;
    }
  }

  /* Corner tick marks — lime accent */
  .tick {
    position: absolute;
    width: 10px;
    height: 10px;
    display: block;
  }
  .tick::before,
  .tick::after {
    content: '';
    position: absolute;
    background: #A6FF00;
  }
  .tick::before { width: 1.5px; height: 10px; }
  .tick::after  { width: 10px;  height: 1.5px; }

  .tick-tl { top: -1px;  left: -1px;  }
  .tick-tl::before { top: 0; left: 0; }
  .tick-tl::after  { top: 0; left: 0; }

  .tick-tr { top: -1px;  right: -1px; }
  .tick-tr::before { top: 0; right: 0; }
  .tick-tr::after  { top: 0; right: 0; }

  .tick-bl { bottom: -1px; left: -1px;  }
  .tick-bl::before { bottom: 0; left: 0; }
  .tick-bl::after  { bottom: 0; left: 0; }

  .tick-br { bottom: -1px; right: -1px; }
  .tick-br::before { bottom: 0; right: 0; }
  .tick-br::after  { bottom: 0; right: 0; }

  .portrait-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .portrait-initials {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    color: rgba(255, 255, 255, 0.18);
    letter-spacing: 0.04em;
    user-select: none;
    position: relative;
    z-index: 1;
  }

  /* Subtle scanline overlay on portrait */
  .portrait-scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(255, 255, 255, 0.025) 3px,
      rgba(255, 255, 255, 0.025) 4px
    );
    pointer-events: none;
  }

  /* ── Identity block ───────────────────────────────────── */
  .identity-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .dossier-meta-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dossier-meta-chip {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #A6FF00;
    background: rgba(166, 255, 0, 0.10);
    border: 1px solid rgba(166, 255, 0, 0.25);
    padding: 2px 6px;
    line-height: 1.4;
  }

  .dossier-meta-sep {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.1em;
  }

  .dossier-meta-text {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.30);
  }

  .dossier-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.35rem, 4vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: #FFFFFF;
    margin: 0;
  }

  .dossier-role-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: #A6FF00;
    margin-top: 0.125rem;
  }

  .role-accent-pip {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: #A6FF00;
    flex-shrink: 0;
  }

  /* ── Divider ──────────────────────────────────────────── */
  .dossier-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 1.5rem 1.5rem 0;
  }

  @media (min-width: 640px) {
    .dossier-divider {
      margin: 1.75rem 2rem 0;
    }
  }

  /* ── Body ─────────────────────────────────────────────── */
  .dossier-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 1.5rem;
  }

  @media (min-width: 640px) {
    .dossier-body {
      padding: 1.75rem 2rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .dossier-body {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      padding: 2rem 2rem 2.25rem;
    }
  }

  /* ── Bio ──────────────────────────────────────────────── */
  .bio-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bio-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.60);
    margin: 0;
  }

  /* Quote */
  .dossier-quote {
    position: relative;
    margin: 0.5rem 0 0;
    padding: 0.875rem 1rem 0.875rem 1.125rem;
    border-left: 2px solid #A6FF00;
    background: rgba(166, 255, 0, 0.04);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
  }

  .quote-mark {
    font-style: normal;
    color: #A6FF00;
    font-weight: 700;
    font-size: 1rem;
    opacity: 0.85;
  }

  /* ── Spec sheet ───────────────────────────────────────── */
  .spec-sheet {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .spec-header-text {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.30);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .spec-header-line {
    display: block;
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.10);
  }

  /* Table */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .spec-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-label,
  .spec-value {
    padding: 0.55rem 0;
    vertical-align: top;
    line-height: 1.4;
  }

  .spec-label {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.30);
    width: 38%;
    padding-right: 0.75rem;
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    font-variant-numeric: tabular-nums;
  }

  /* ── No overflow safety ───────────────────────────────── */
  .dossier-card,
  .dossier-name,
  .bio-text,
  .dossier-quote,
  .spec-value {
    word-break: break-word;
    overflow-wrap: break-word;
  }
</style>
