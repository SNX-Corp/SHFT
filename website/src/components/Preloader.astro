---
// SHFT Split Preloader — adapted from the Claude Design handoff
// (shft/project/SHFT Split Preloader.html). The wordmark straddles a centre
// seam; glitch intro, looping shine, then the two panels open like doors
// (top up / bottom down) to reveal the page. Logo sized to the hero wordmark.
const LOGO = '/images/logo/wordmark.png';
---

<div id="shft-pre" class="splitter exit-split intro-glitch" aria-hidden="true">
  <div class="panel top">
    <img class="half" src={LOGO} alt="Team SHFT" draggable="false" />
    <div class="gh r"></div>
    <div class="gh c"></div>
    <div class="shine"></div>
  </div>
  <div class="panel bottom">
    <img class="half" src={LOGO} alt="" draggable="false" />
    <div class="gh r"></div>
    <div class="gh c"></div>
    <div class="shine"></div>
  </div>
</div>

<style>
  /* Hidden until the boot script opts in (keeps reduced-motion clean, no flash) */
  :global(html.shft-preloading) { overflow: hidden; }
  .splitter { display: none; }
  :global(html.shft-preloading) .splitter { display: block; }

  .splitter {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    --accent: #a6ff00;
    --panel: #121212;
    --gx: 5px;
    --open: 0.8s;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    /* Logo sized to the hero wordmark. The min() also caps it by width so the
       wordmark never overflows on narrow phones (matches the hero logo, which
       is width-capped to ~90vw). 26.7vw tall keeps the 1225:364 mark at ~90vw. */
    --lh: min(clamp(4.75rem, 18vh, 12.5rem), 26.7vw);
    --logo-w: calc(var(--lh) * 1225 / 364);
    /* seam (where the logo straddles + doors split) = hero logo centre;
       the boot script measures the real hero slot and overrides this. */
    --seam: 48%;
  }

  .panel {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    background: var(--panel);
    will-change: transform;
  }
  .panel.top { top: 0; height: var(--seam); }
  .panel.bottom { top: var(--seam); height: calc(100% - var(--seam)); }
  /* hairline seam to telegraph the split */
  .panel.top::after,
  .panel.bottom::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(166, 255, 0, 0.22) 30%, rgba(166, 255, 0, 0.22) 70%, transparent);
  }
  .panel.top::after { bottom: 0; }
  .panel.bottom::before { top: 0; }

  /* the mark — full logo straddling the seam (each door shows its half) */
  .half { position: absolute; left: 50%; width: var(--logo-w); height: var(--lh); transform: translate(-50%, 0); object-fit: contain; -webkit-user-drag: none; user-select: none; }
  .panel.top .half { top: calc(100% - var(--lh) / 2); }
  .panel.bottom .half { top: calc(var(--lh) / -2); }

  /* RGB ghosts (glitch intro) */
  .gh {
    position: absolute; left: 50%; width: var(--logo-w); height: var(--lh); transform: translate(-50%, 0);
    mix-blend-mode: screen; opacity: 0; pointer-events: none;
    -webkit-mask: url('/images/logo/wordmark.png') center/contain no-repeat;
            mask: url('/images/logo/wordmark.png') center/contain no-repeat;
  }
  .gh.r { background: #ff0033; }
  .gh.c { background: #00e7ff; }
  .panel.top .gh { top: calc(100% - var(--lh) / 2); }
  .panel.bottom .gh { top: calc(var(--lh) / -2); }

  /* ===== GLITCH intro: RGB-split stutter ===== */
  .splitter.intro-glitch .panel .half { animation: gMain .72s steps(1, end) both; }
  @keyframes gMain {
    0% { opacity: 0; clip-path: inset(40% 0 34% 0); transform: translate(-50%, 0) translateX(calc(var(--gx) * -1.4)); }
    12% { opacity: 1; clip-path: inset(0 0 58% 0); transform: translate(-50%, 0) translateX(calc(var(--gx) * 1.6)); }
    24% { clip-path: inset(54% 0 0 0); transform: translate(-50%, 0) translateX(calc(var(--gx) * -1.8)); }
    38% { clip-path: inset(22% 0 38% 0); transform: translate(-50%, 0) translateX(calc(var(--gx) * .8)); }
    56% { clip-path: inset(0 0 0 0); transform: translate(-50%, 0); }
    100% { clip-path: inset(0 0 0 0); transform: translate(-50%, 0); opacity: 1; }
  }
  .splitter.intro-glitch .panel .gh.r { animation: gR .72s steps(1, end) both; }
  .splitter.intro-glitch .panel .gh.c { animation: gC .72s steps(1, end) both; }
  @keyframes gR {
    0% { opacity: 0; transform: translate(-50%, 0) translate(calc(var(--gx) * -2), 2px); }
    14% { opacity: .85; transform: translate(-50%, 0) translate(calc(var(--gx) * -2.4), -2px); }
    32% { transform: translate(-50%, 0) translate(calc(var(--gx) * 1.4), 1px); }
    54% { transform: translate(-50%, 0) translate(calc(var(--gx) * -.8), 0); }
    100% { opacity: 0; transform: translate(-50%, 0) translate(0, 0); }
  }
  @keyframes gC {
    0% { opacity: 0; transform: translate(-50%, 0) translate(calc(var(--gx) * 2), -2px); }
    14% { opacity: .85; transform: translate(-50%, 0) translate(calc(var(--gx) * 2.4), 2px); }
    32% { transform: translate(-50%, 0) translate(calc(var(--gx) * -1.4), -1px); }
    54% { transform: translate(-50%, 0) translate(calc(var(--gx) * .8), 0); }
    100% { opacity: 0; transform: translate(-50%, 0) translate(0, 0); }
  }

  /* looping shine that rakes across the mark while loading */
  .shine {
    position: absolute; left: 50%; width: var(--logo-w); height: var(--lh); transform: translate(-50%, 0);
    pointer-events: none; mix-blend-mode: screen; opacity: 0;
    -webkit-mask: url('/images/logo/wordmark.png') center/contain no-repeat;
            mask: url('/images/logo/wordmark.png') center/contain no-repeat;
    background: linear-gradient(100deg, transparent 41%, rgba(255, 255, 255, 0.92) 49%, rgba(166, 255, 0, 0.55) 53%, transparent 61%);
    background-size: 250% 100%; background-repeat: no-repeat; background-position: 175% 0;
  }
  .panel.top .shine { top: calc(100% - var(--lh) / 2); animation: shineSweep 1.7s var(--ease) 0.7s infinite; }
  .panel.bottom .shine { top: calc(var(--lh) / -2); animation: shineSweep 1.7s var(--ease) 0.7s infinite; }
  @keyframes shineSweep {
    0% { background-position: 175% 0; opacity: 0; }
    9% { opacity: 1; }
    48% { background-position: -75% 0; opacity: 1; }
    56%, 100% { background-position: -75% 0; opacity: 0; }
  }
  .splitter.open .shine { animation: none !important; opacity: 0; }

  /* OPEN — top door up, bottom door down */
  .splitter.exit-split.open .panel.top { animation: doorTop var(--open) cubic-bezier(0.76, 0, 0.24, 1) 0.06s forwards; }
  .splitter.exit-split.open .panel.bottom { animation: doorBottom var(--open) cubic-bezier(0.76, 0, 0.24, 1) 0.06s forwards; }
  @keyframes doorTop { to { transform: translateY(-100%); } }
  @keyframes doorBottom { to { transform: translateY(100%); } }

  /* FADE — alternative exit (unused by default) */
  .splitter.exit-fade.open { opacity: 0; transition: opacity .45s var(--ease); }

  @media (prefers-reduced-motion: reduce) {
    .splitter { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById('shft-pre');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!pre || reduce) { if (pre) pre.remove(); return; }

    // Cover the page immediately and gate the hero intro until the doors open.
    root.classList.add('shft-preloading');

    // Line the seam (and the logo that straddles it) up with the real hero
    // wordmark, so the mark is in the exact same spot when the doors open.
    function placeSeam() {
      var slot = document.querySelector('[data-hero-logo-slot]');
      if (!slot) return;
      var r = slot.getBoundingClientRect();
      var y = ((r.top + r.height / 2) / window.innerHeight) * 100;
      if (y > 8 && y < 92) pre.style.setProperty('--seam', y.toFixed(2) + '%');
    }
    requestAnimationFrame(function () { requestAnimationFrame(placeSeam); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(placeSeam);

    var WAIT = 1200; // closed time before the doors open (kept snappy)
    var DOOR = 950;  // door animation + small buffer
    var revealed = false;

    function reveal() {
      if (revealed) return;
      revealed = true;
      pre.classList.add('open');                       // slide the doors apart
      window.dispatchEvent(new Event('shft:reveal'));   // let the hero intro start
      setTimeout(function () {
        root.classList.remove('shft-preloading');
        if (pre && pre.parentNode) pre.parentNode.removeChild(pre);
      }, DOOR);
    }

    setTimeout(reveal, WAIT);
  })();
</script>
