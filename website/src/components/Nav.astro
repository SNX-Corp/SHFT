---
import { getEntry } from 'astro:content';
import RollText from './RollText.astro';

const entry = await getEntry('sections', 'nav');
const d = entry!.data as {
  cta_label: string;
  cta_href: string;
  links: Array<{ label: string; href: string }>;
};
const navLinks = d.links;
---

<header
  id="nav"
  class="fixed top-0 left-0 right-0 z-[var(--z-nav)] bg-transparent transition-colors duration-[var(--duration-normal)]"
  data-nav
>
  <div class="relative content-width box-border max-w-full flex items-center justify-center h-16 lg:h-20">
    <!-- Centered link cluster: 2 links, logo gap, 2 links -->
    <nav class="hidden lg:flex items-center gap-7" data-nav-chrome>
      {navLinks.slice(0, 2).map((link) => (
        <a
          href={link.href}
          class="font-heading font-semibold text-[13px] uppercase tracking-[0.1em] text-white hover:text-accent transition-colors duration-200"
          data-nav-link
        >
          <RollText text={link.label} />
        </a>
      ))}

      <!-- Reserved gap the centered morphing logo sits over -->
      <span class="block shrink-0" style="width: 200px;" aria-hidden="true"></span>

      {navLinks.slice(2, 4).map((link) => (
        <a
          href={link.href}
          class="font-heading font-semibold text-[13px] uppercase tracking-[0.1em] text-white hover:text-accent transition-colors duration-200"
          data-nav-link
        >
          <RollText text={link.label} />
        </a>
      ))}
    </nav>

    <!-- Far-right CTA -->
    <div class="hidden lg:block absolute right-6" data-nav-cta-wrap>
      <a
        href={d.cta_href}
        class="inline-block bg-accent text-accent-text font-heading font-bold text-[13px] uppercase tracking-wide px-5 py-2.5 hover:bg-accent-hover transition-all duration-200 active:scale-[0.97]"
        data-nav-cta
        data-open-join-modal
      >
        <RollText text={d.cta_label} />
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="lg:hidden fixed top-3 right-4 z-[60] flex flex-col justify-center items-center w-11 h-11 gap-[6px] rounded-full border border-accent bg-accent shadow-[0_8px_24px_rgba(0,0,0,.28)] backdrop-blur-sm transition-colors duration-200 group"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-mobile-toggle
    >
      <span class="block w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" data-bar-1></span>
      <span class="block w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" data-bar-2></span>
    </button>
  </div>
</header>

<!-- Morphing brand logo: starts big + centered in the hero, scales down into the navbar center on scroll. Fixed so it floats above everything. -->
<a href="/" class="brand-logo" data-brand-logo aria-label="Team SHFT - home">
  <img src="/images/logo/wordmark.png" alt="Team SHFT" class="brand-logo__img" data-brand-light />
  <img src="/images/logo/wordmark-dark.png" alt="" aria-hidden="true" class="brand-logo__img brand-logo__img--dark" data-brand-dark />
</a>

<!-- Mobile overlay -->
<div
  class="fixed inset-0 z-[var(--z-overlay)] bg-bg pointer-events-none opacity-0 transition-opacity duration-300 lg:hidden"
  data-mobile-menu
>
  <div class="flex flex-col items-center justify-center h-full gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-heading font-bold text-[clamp(1.5rem,7vw,2rem)] uppercase tracking-tight text-text-primary hover:text-accent transition-colors duration-200"
        data-mobile-link
      >
        {link.label}
      </a>
    ))}
    <a
      href={d.cta_href}
      class="mt-4 bg-accent text-accent-text font-heading font-bold text-[14px] uppercase tracking-wide px-8 py-4 hover:bg-accent-hover transition-colors duration-200"
      data-mobile-link
      data-open-join-modal
    >
      {d.cta_label}
    </a>
  </div>
</div>

<style>
  .brand-logo {
    position: fixed;
    left: 50%;
    top: 2rem; /* nav center on mobile (h-16 = 64px) */
    z-index: calc(var(--z-nav) + 5);
    display: block;
    height: 22px;
    transform: translate(-50%, -50%);
    transform-origin: center center;
    will-change: transform, opacity, filter;
    opacity: 0;
  }
  @media (min-width: 1024px) {
    .brand-logo {
      top: 2.5rem; /* nav center on desktop (h-20 = 80px) */
      height: 28px;
    }
  }
  .brand-logo__img {
    display: block;
    height: 100%;
    width: auto;
    transition: opacity 0.3s ease;
  }
  .brand-logo__img--dark {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  /* Hidden until the scroll logic fades them in (prevents a flash on load) */
  [data-nav-chrome],
  [data-nav-cta-wrap] {
    opacity: 0;
  }
  /* Hide the floating logo while the hero zoom is focused */
  .hero-stage.is-robot-focus ~ .brand-logo {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const navChrome = document.querySelector('[data-nav-chrome]') as HTMLElement;
  const navCtaWrap = document.querySelector('[data-nav-cta-wrap]') as HTMLElement;
  const navLinks = document.querySelectorAll('[data-nav-link]');
  const navCta = document.querySelector('[data-nav-cta]') as HTMLElement;
  const brand = document.querySelector('[data-brand-logo]') as HTMLElement;
  const brandLight = document.querySelector('[data-brand-light]') as HTMLElement;
  const brandDark = document.querySelector('[data-brand-dark]') as HTMLElement;
  const slot = document.querySelector('[data-hero-logo-slot]') as HTMLElement;
  const heroCopy = document.querySelector('[data-hero-copy]') as HTMLElement;
  const heroScroll = document.querySelector('[data-hero-scroll]') as HTMLElement;

  const mobileToggle = document.querySelector('[data-mobile-toggle]') as HTMLElement;
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement;
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const bar1 = document.querySelector('[data-bar-1]') as HTMLElement;
  const bar2 = document.querySelector('[data-bar-2]') as HTMLElement;

  let menuOpen = false;

  // Geometry of the morph (recomputed on load + resize)
  let dy = 0; // vertical offset from nav-center to hero-center
  let heroScale = 4; // how much bigger the logo is in the hero

  function measure() {
    if (!brand || !slot) return;
    const navH = nav ? nav.offsetHeight : 72;
    const navCenterY = navH / 2;
    const slotRect = slot.getBoundingClientRect();
    const slotCenterViewportTop = slotRect.top + window.scrollY + slotRect.height / 2;
    dy = slotCenterViewportTop - navCenterY;
    const logoH = brand.offsetHeight || 28;
    heroScale = Math.max(1, (slotRect.height || logoH * 4) / logoH);
  }

  function setBars(dark: boolean) {
    if (!mobileToggle) return;
    mobileToggle.classList.toggle('border-black/10', dark);
    mobileToggle.classList.toggle('bg-white/85', dark);
    mobileToggle.classList.toggle('border-accent', !dark);
    mobileToggle.classList.toggle('bg-accent', !dark);
  }

  function update() {
    const vh = window.innerHeight;
    const y = window.scrollY;

    // Morph progress: the logo stays full-size + centered, then snaps up and
    // docks into the nav. When the hero is pinned (desktop) the next section is
    // held off-screen, so we hold the wordmark almost to the end of the pin and
    // dock right before it releases. Ease-in (squared) keeps it planted, then
    // accelerates the move so it never slowly drifts.
    const pinned = document.documentElement.classList.contains('hero-pinned');
    const D = vh * 0.85; // must match the hero pin distance in animations.ts
    const holdEnd = pinned ? D * 0.72 : vh * 0.52;
    const dockRange = pinned ? D * 0.25 : vh * 0.2;
    const pRaw = Math.min(1, Math.max(0, (y - holdEnd) / dockRange));
    const p = pRaw * pRaw;
    const inv = 1 - p;

    // Fade the hero copy (eyebrow + tagline + button) out early so it never
    // scrolls up through the held logo. The logo itself stays put. Only once
    // scrolling, so the load-in intro keeps ownership of these at the top.
    if (y > 2) {
      const copyFade = Math.min(1, Math.max(0, 1 - y / (vh * 0.3)));
      if (heroCopy) heroCopy.style.opacity = String(copyFade);
      if (heroScroll) heroScroll.style.opacity = String(copyFade);
    }

    // Move + scale the floating logo from hero-center (p=0) to nav-center (p=1)
    if (brand) {
      const scale = 1 + (heroScale - 1) * inv;
      brand.style.transform = `translate(-50%, -50%) translateY(${dy * inv}px) scale(${scale})`;
      // Opacity is owned by the hero intro timeline (logo fades in first).
      // Only clickable once docked in the nav, so it never blocks the hero.
      brand.style.pointerEvents = p > 0.85 ? 'auto' : 'none';
    }

    // Fade the nav chrome (links + CTA) in as the logo docks
    const chrome = Math.min(1, Math.max(0, (p - 0.15) / 0.6));
    if (navChrome) {
      navChrome.style.opacity = String(chrome);
      navChrome.style.transform = `translateY(${(1 - chrome) * -6}px)`;
      navChrome.style.pointerEvents = chrome > 0.85 ? 'auto' : 'none';
    }
    if (navCtaWrap) {
      navCtaWrap.style.opacity = String(chrome);
      navCtaWrap.style.transform = `translateY(${(1 - chrome) * -6}px)`;
      navCtaWrap.style.pointerEvents = chrome > 0.85 ? 'auto' : 'none';
    }

    // Background + colour swap once we're past the hero
    const pastHero = y > (pinned ? D * 0.98 : vh * 0.88);
    if (pastHero) {
      nav.classList.add('bg-bg', 'shadow-[0_1px_0_var(--color-border)]');
      nav.classList.remove('bg-transparent');
      if (brandLight) brandLight.style.opacity = '0';
      if (brandDark) brandDark.style.opacity = '1';
      navLinks.forEach((l) => {
        l.classList.remove('text-white');
        l.classList.add('text-text-secondary', 'hover:text-text-primary');
      });
    } else {
      nav.classList.remove('bg-bg', 'shadow-[0_1px_0_var(--color-border)]');
      nav.classList.add('bg-transparent');
      if (brandLight) brandLight.style.opacity = '1';
      if (brandDark) brandDark.style.opacity = '0';
      navLinks.forEach((l) => {
        l.classList.add('text-white');
        l.classList.remove('text-text-secondary', 'hover:text-text-primary');
      });
    }

    if (!menuOpen) setBars(pastHero);
  }

  function toggleMobile() {
    menuOpen = !menuOpen;
    mobileToggle.setAttribute('aria-expanded', String(menuOpen));
    if (menuOpen) {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
      bar1.style.transform = 'rotate(45deg) translateY(4px)';
      bar2.style.transform = 'rotate(-45deg) translateY(-4px)';
      setBars(true);
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
      bar1.style.transform = '';
      bar2.style.transform = '';
      document.body.style.overflow = '';
      update();
    }
  }

  mobileToggle?.addEventListener('click', toggleMobile);
  mobileLinks.forEach((link) => link.addEventListener('click', () => {
    if (menuOpen) toggleMobile();
  }));

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', () => { measure(); update(); });
  window.addEventListener('load', () => { measure(); update(); });
  measure();
  update();
</script>
