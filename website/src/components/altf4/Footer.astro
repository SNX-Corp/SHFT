<footer style="border-top:1px solid var(--color-af-border);background:var(--color-af-pure);">
  <div class="af-wrap af-section" style="padding-block:4rem;">
    <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:2.5rem;" class="af-foot-grid">
      <div>
        <img src="/images/altf4/logo-white.png" alt="ALT-F4" style="height:36px;width:auto;margin-bottom:1rem;" />
        <p class="af-body" style="max-width:34ch;font-size:.92rem;">FIRST Robotics Competition Team 7558. Built at Bayview Glen, Toronto. Competing across Ontario since 2019.</p>
      </div>
      <div>
        <div class="af-mono" style="font-size:.66rem;letter-spacing:.2em;color:var(--color-af-red);text-transform:uppercase;margin-bottom:1rem;">Contact</div>
        <a href="mailto:mpestonji@bayviewglen.ca" class="af-body" style="display:block;font-size:.88rem;margin-bottom:.4rem;">mpestonji@bayviewglen.ca</a>
        <span class="af-mono" style="font-size:.66rem;color:var(--color-af-muted);display:block;margin-bottom:.9rem;">Robotics Coordinator</span>
        <a href="mailto:nkashif@bayviewglen.ca" class="af-body" style="display:block;font-size:.88rem;margin-bottom:.4rem;">nkashif@bayviewglen.ca</a>
        <span class="af-mono" style="font-size:.66rem;color:var(--color-af-muted);">FRC Specialist</span>
      </div>
      <div>
        <div class="af-mono" style="font-size:.66rem;letter-spacing:.2em;color:var(--color-af-red);text-transform:uppercase;margin-bottom:1rem;">Links</div>
        <a href="https://team7558.com" class="af-body" style="display:block;font-size:.88rem;margin-bottom:.5rem;">team7558.com</a>
        <a href="https://www.thebluealliance.com/team/7558" class="af-body" style="display:block;font-size:.88rem;margin-bottom:.5rem;">The Blue Alliance</a>
        <a href="https://www.statbotics.io/team/7558" class="af-body" style="display:block;font-size:.88rem;margin-bottom:.5rem;">Statbotics</a>
        <a href="https://www.bayviewglen.ca" class="af-body" style="display:block;font-size:.88rem;">Bayview Glen</a>
      </div>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--color-af-border);flex-wrap:wrap;gap:.5rem;">
      <span class="af-mono" style="font-size:.66rem;color:var(--color-af-muted);letter-spacing:.1em;">© 2026 ALT-F4 · FRC TEAM 7558</span>
      <span class="af-mono" style="font-size:.66rem;color:var(--color-af-muted);letter-spacing:.1em;">INNOVATE. BUILD. COMPETE.</span>
    </div>
  </div>
</footer>
<style>
  @media (max-width: 760px) { .af-foot-grid { grid-template-columns: 1fr !important; } }
</style>
