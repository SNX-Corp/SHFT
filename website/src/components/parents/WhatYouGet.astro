---
import { getEntry } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';

const entry = await getEntry('sections', 'experience');
const d = entry!.data as {
  section_number: string;
  section_label: string;
  headline_line_1: string;
  headline_line_2: string;
  intro: string;
  cards: Array<{
    number: string;
    title: string;
    description: string;
    accent: boolean;
  }>;
};
---

<section id="program" class="py-16 lg:py-28 bg-bg">
  <div class="content-width">
    <SectionLabel number={d.section_number} text={d.section_label} />

    <h2 class="font-display font-black text-h2-size mb-6">
      <span class="title-shine is-dark delay-4">{d.headline_line_1}</span><br/>
      <span class="title-shine is-dark delay-5">{d.headline_line_2}</span>
    </h2>

    <p class="font-body text-[16px] text-text-secondary leading-relaxed max-w-2xl mb-16">
      {d.intro}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {d.cards.map((item) => (
        <div class:list={[
          "border border-border p-8 lg:p-10 group hover:border-accent/30 transition-colors duration-200",
          item.accent && "border-t-2 border-t-accent",
        ]}>
          <div class="font-display font-black text-[2rem] text-border/60 leading-none mb-4">{item.number}</div>
          <h3 class="font-heading font-bold text-[18px] text-text-primary mb-3">{item.title}</h3>
          <p class="font-body text-[14px] text-text-secondary leading-[1.8]">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
