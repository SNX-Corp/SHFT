---
/**
 * SMark - Team SHIFT primary logo (S-mark).
 * Reads the autotraced SS.svg, splits its compound path into the outer
 * square + 3 logo pieces: top hook + bottom hook (ink) and the middle
 * diagonal connector (neon green).
 */
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const svgRaw = fs.readFileSync(
  fileURLToPath(new URL('../../../public/images/logo/SS.svg', import.meta.url)),
  'utf8',
);
const d = svgRaw.match(/<path d="([^"]+)"/)![1].replace(/\s+/g, ' ').trim();
const parts = d.split(/z/i).filter((s) => s.trim()).map((s) => s.trim());
let cur = [0, 0];
const subpaths = parts.map((p) => {
  const m = p.match(/^([Mm])\s*(-?[\d.]+)[ ,]+(-?[\d.]+)/)!;
  let sx: number, sy: number;
  if (m[1] === 'M') { sx = +m[2]; sy = +m[3]; }
  else { sx = cur[0] + +m[2]; sy = cur[1] + +m[3]; }
  cur = [sx, sy];
  return p.replace(/^([Mm])\s*(-?[\d.]+)[ ,]+(-?[\d.]+)/, `M${sx} ${sy}`) + 'z';
});
// subpaths[0] = outer square frame (unused), [1] top hook, [2] mid diagonal, [3] bottom hook

interface Props {
  size?: string;
  mode?: 'dark' | 'light';
  class?: string;
}
const { size = '64px', mode = 'dark', class: className = '' } = Astro.props;
const ink = mode === 'dark' ? '#FFFFFF' : '#1A1A1A';
const accent = '#A6FF00';
---

<svg
  class={className}
  viewBox="0 0 614 508"
  style={`width:${size};height:auto;display:block`}
  role="img"
  aria-label="Team SHIFT"
>
  <g transform="translate(0,508) scale(0.1,-0.1)">
    <path d={subpaths[1]} fill={ink} />
    <path d={subpaths[2]} fill={accent} />
    <path d={subpaths[3]} fill={ink} />
  </g>
</svg>
