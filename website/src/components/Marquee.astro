---
import { getEntry } from 'astro:content';

const entry = await getEntry('sections', 'marquee');
const items = (entry!.data as { items: string[] }).items;

const marqueeContent = items.join('     •     ') + '     •     ';
---

<div class="relative z-[var(--z-marquee)] bg-accent overflow-hidden py-4 lg:py-5 select-none">
  <div class="flex whitespace-nowrap animate-[marquee_3.4s_linear_infinite]">
    <span class="font-heading font-bold text-[13px] lg:text-[15px] uppercase tracking-[0.18em] text-accent-text px-8">
      {marqueeContent}
    </span>
    <span class="font-heading font-bold text-[13px] lg:text-[15px] uppercase tracking-[0.18em] text-accent-text px-8" aria-hidden="true">
      {marqueeContent}
    </span>
    <span class="font-heading font-bold text-[13px] lg:text-[15px] uppercase tracking-[0.18em] text-accent-text px-8" aria-hidden="true">
      {marqueeContent}
    </span>
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>
